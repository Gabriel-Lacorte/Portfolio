---
import Head from "@components/Head.astro";
import Banner from "@components/ascii/Banner.astro";
import Sigil from "@components/ascii/Sigil.astro";
import { NAV_KEYS, SITE, SOCIALS } from "@consts";
import { HTML_LANG, LOCALE_LABEL, LOCALES } from "@i18n/ui";
import {
    localised,
    unlocalised,
    useTranslations,
    type Locale,
} from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;
    /** Home passes false — its <title> is just the site name. */
    suffix?: boolean;
    /** Home shows the floating windows and the taskbar. */
    windows?: boolean;
};

const {
    locale,
    title,
    description,
    suffix = true,
    windows = false,
} = Astro.props;

const t = useTranslations(locale);

/* Compared with the locale segment stripped, so the same logic serves both
   languages. */
const here = unlocalised(Astro.url.pathname);
const isCurrent = (href: string) =>
    href === "/" ? here === "/" : here === href || here.startsWith(href + "/");
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
    <head>
        <Head
            locale={locale}
            title={suffix ? `${title} | ${SITE.TITLE}` : title}
            description={description}
        />
    </head>
    <body class:list={[windows && "has-windows"]}>
        <a class="skip" href="#main">{t("action.skip")}</a>

        <div class="container">
            <header class="site">
                <Sigil />
                <Banner />

                <nav class="menu" aria-label="Main">
                    <ul>
                        {
                            NAV_KEYS.map(({ KEY, HREF }) => (
                                <li>
                                    <a
                                        href={localised(HREF, locale)}
                                        aria-current={
                                            isCurrent(HREF) ? "page" : undefined
                                        }
                                    >
                                        [ {t(KEY)} ]
                                    </a>
                                </li>
                            ))
                        }
                        <li class="lang">
                            {
                                LOCALES.map((code, i) => (
                                    <>
                                        {i > 0 && " / "}
                                        <a
                                            href={localised(here, code)}
                                            hreflang={HTML_LANG[code]}
                                            aria-current={
                                                code === locale
                                                    ? "true"
                                                    : undefined
                                            }
                                        >
                                            {LOCALE_LABEL[code]}
                                        </a>
                                    </>
                                ))
                            }
                        </li>
                    </ul>
                </nav>
            </header>

            <main id="main">
                <slot />
            </main>

            <slot name="windows" />

            <footer class="site">
                <div class="contacts">
                    <span>
                        <span class="comment">mail:</span>{" "}
                        <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
                    </span>
                    <span>
                        {
                            SOCIALS.map(({ NAME, HREF }, i) => (
                                <>
                                    {i > 0 && " | "}
                                    <a
                                        href={HREF}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {NAME}
                                    </a>
                                </>
                            ))
                        }
                    </span>
                </div>
            </footer>

            <div class="buttons88">
                <img
                    src="/buttons/lacorte.png"
                    width="88"
                    height="31"
                    alt="lacorte.city — 88x31 button, free to hotlink"
                />
<img
                    src="/buttons/nojs.png"
                    width="88"
                    height="31"
                    alt="This site needs no JavaScript"
                />
                <img
                    src="/buttons/astro.png"
                    width="88"
                    height="31"
                    alt="Built with Astro"
                />
            </div>
        </div>

        <slot name="taskbar" />
    </body>
</html>
