---
import Head from "@components/Head.astro";
import { BADGES, NAV_KEYS, SITE, SOCIALS } from "@consts";
import { HTML_LANG, LOCALE_LABEL, LOCALES } from "@i18n/ui";
import {
    localised,
    unlocalised,
    useTranslations,
    type Locale,
} from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;
    /** Home passes false, its <title> is just the site name. */
    suffix?: boolean;
    /** Home shows the floating windows and the taskbar. */
    windows?: boolean;
    /** Forwarded to <Head>, locales whose route serves borrowed text. */
    untranslated?: Locale[];
    /** Forwarded to <Head>, keeps the page out of the index. */
    noindex?: boolean;
    /** Forwarded to <Head>, points the canonical at another route. */
    canonicalPath?: string;
    /** Forwarded to <Head>, article facts for JSON-LD. */
    article?: {
        headline: string;
        published: Date;
        lang: string;
        tags?: string[];
        words?: number;
    };
};

const {
    locale,
    title,
    description,
    suffix = true,
    windows = false,
    untranslated = [],
    noindex = false,
    canonicalPath,
    article,
} = Astro.props;

const t = useTranslations(locale);

/* Compared with the locale segment stripped, so the same logic serves both
   languages. */
const here = unlocalised(Astro.url.pathname);
const isCurrent = (href: string) =>
    href === "/" ? here === "/" : here === href || here.startsWith(href + "/");

/* The client script builds copy buttons and window chrome after render, so its
   labels have to be handed to it rather than guessed from the lang attribute
   inside the script, which is how they drifted out of the dictionary before. */
const uiStrings = JSON.stringify({
    copy: t("action.copy"),
    copied: t("action.copied"),
    copyFailed: t("action.copyFailed"),
    copyLabel: t("action.copyLabel"),
    moveHint: t("win.moveHint"),
});
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
    <head>
        <Head
            locale={locale}
            title={suffix ? `${title} | ${SITE.TITLE}` : title}
            description={description}
            untranslated={untranslated}
            noindex={noindex}
            canonicalPath={canonicalPath}
            article={article}
        />
    </head>
    <body class:list={[windows && "has-windows"]} data-ui={uiStrings}>
        <a class="skip" href="#main">{t("action.skip")}</a>

        <div class="container">
            <header class="site">
                <slot name="ident">
                    <p class="ident">
                        <span class="mark">{SITE.HANDLE}</span>
                        <span class="who">{t("site.tagline")}</span>
                    </p>
                </slot>

                <nav class="menu" aria-label="Main">
                    <ul>
                        {
                            NAV_KEYS.map(({ KEY, HREF }) => (
                                <li>
                                    <a
                                        href={localised(HREF, locale)}
                                        aria-current={
                                            isCurrent(HREF) ? "page" : undefined
                                        }
                                        >[ {t(KEY)} ]</a
                                    >
                                </li>
                            ))
                        }
                    </ul>
                    <ul>
                        <li class="lang">
                            {
                                LOCALES.map((code, i) => (
                                    <>
                                        {i > 0 && " / "}
                                        <a
                                            href={localised(here, code)}
                                            hreflang={HTML_LANG[code]}
                                            aria-current={
                                                code === locale
                                                    ? "true"
                                                    : undefined
                                            }
                                            >{LOCALE_LABEL[code]}</a
                                        >
                                    </>
                                ))
                            }
                        </li>
                    </ul>
                </nav>
            </header>

            <main id="main">
                <slot />
            </main>

            {
                windows && (
                    <div class="windows">
                        <slot name="windows" />
                    </div>
                )
            }

            <footer class="site">
                <div class="contacts">
                    <span>
                        <span class="comment">mail:</span>{" "}
                        <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
                    </span>
                    <span>
                        <span class="comment">feed:</span>{" "}
                        <a href={localised("/feed.xml", locale)}>rss</a>
                    </span>
                    <span>
                        {
                            SOCIALS.map(({ NAME, HREF }, i) => (
                                <>
                                    {i > 0 && " | "}
                                    <a
                                        href={HREF}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        >{NAME}</a
                                    >
                                </>
                            ))
                        }
                    </span>
                </div>
            </footer>

            <div class="buttons88">
                {
                    /* A badge that loops forever is the one moving thing the
                       global reduced-motion rules cannot reach, so animated
                       ones ship a still frame alongside. */
                    BADGES.map((badge) => {
                        const img = (
                            <img
                                src={badge.SRC}
                                width={badge.W}
                                height={badge.H}
                                lang={badge.LANG}
                                alt={badge.ALT}
                            />
                        );
                        const art = badge.STILL ? (
                            <picture>
                                <source
                                    srcset={badge.STILL}
                                    media="(prefers-reduced-motion: reduce)"
                                />
                                {img}
                            </picture>
                        ) : (
                            img
                        );
                        return badge.HREF ? (
                            <a
                                href={badge.HREF}
                                target="_blank"
                                rel="noopener noreferrer"
                                >{art}</a
                            >
                        ) : (
                            art
                        );
                    })
                }
            </div>
        </div>

        {
            /* Shell only. The buttons are built from the windows actually on
               the page, so the two can never drift apart, and a scripting-off
               visitor gets no controls for windows they cannot close anyway. */
            windows && (
                <div class="taskbar" role="group" aria-label={t("win.windows")} />
            )
        }
    </body>
</html>
