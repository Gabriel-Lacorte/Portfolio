---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
    title: string;
    description: string;
    /** Home passes false — its <title> is just the site name. */
    suffix?: boolean;
};

const { title, description, suffix = true } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <Head
            title={suffix ? `${title} — ${SITE.TITLE}` : title}
            description={description}
        />
    </head>
    <body>
        <a class="skip-link" href="#content">Skip to content</a>
        <Header />
        <main id="content" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
