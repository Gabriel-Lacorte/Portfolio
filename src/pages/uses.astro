---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import { USES } from "@consts";
---

<Layout
  title="Uses"
  description="Hardware, editor, and the machines this site and my homelab run on."
>
  <div class="stack-gap">
    <Panel title="~/uses" note={`${USES.length} groups`} as="h1">
      <p class="lede">
        What I type on, what I type into, and what it all runs on.
      </p>
    </Panel>

    <div class="grid-2">
      {
        USES.map(({ GROUP, ROWS }) => (
          <Panel title={GROUP} note={`${ROWS.length} rows`}>
            <Spec
              rows={ROWS.map((row) => ({
                k: row.k,
                v: row.v,
                href: row.v.startsWith("/") ? row.v : undefined,
                dim: row.v === "—",
              }))}
            />
          </Panel>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .lede {
    max-width: var(--measure);
  }
</style>
