---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import Dither from "@components/ascii/Dither.astro";
import { NAV } from "@consts";
---

<Layout title="404 — no such file or directory" description="That path does not resolve." suffix={false}>
  <div class="stack-gap">
    <Panel title="fault" note="err 404" as="h1">
      <Dither pattern="check" />
      <p class="msg">
        The path <code>{Astro.url.pathname}</code> does not resolve. It may have
        moved, or it may never have existed.
      </p>
      <Dither pattern="check" />
    </Panel>

    <Panel title="recover" note={`${NAV.length} routes`}>
      <Spec rows={NAV.map(({ LABEL, HREF }) => ({ k: LABEL, v: HREF, href: HREF }))} />
    </Panel>
  </div>
</Layout>

<style>
  .msg {
    max-width: var(--measure);
    margin-block: var(--step);
  }

  code {
    padding: 0.05em 0.5ch;
    border: 1px solid var(--rule);
    color: var(--bright);
    overflow-wrap: anywhere;
  }
</style>
