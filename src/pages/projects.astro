---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import { PROJECTS, PROJECTS_META } from "@consts";

const external = (href: string) => href.startsWith("http");
---

<Layout title={PROJECTS_META.TITLE} description={PROJECTS_META.DESCRIPTION}>
  <div class="stack-gap">
    <Panel title="~/projects" note={`${PROJECTS.length} listed`} as="h1">
      <p class="lede">{PROJECTS_META.DESCRIPTION}</p>
    </Panel>

    {
      PROJECTS.map((project) => (
        <Panel title={project.NAME} note={project.YEAR}>
          <p class="summary">{project.SUMMARY}</p>
          <Spec
            class="kit"
            rows={[
              { k: "stack", v: project.STACK.join(" · ") },
              {
                k: "source",
                v: external(project.HREF) ? "github" : "writeup",
                href: project.HREF,
                external: external(project.HREF),
              },
            ]}
          />
        </Panel>
      ))
    }
  </div>
</Layout>

<style>
  .lede,
  .summary {
    max-width: var(--measure);
  }

  .summary {
    color: var(--dim);
  }

  :global(.spec.kit) {
    margin-top: var(--step);
  }
</style>
