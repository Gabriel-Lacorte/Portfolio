---
import Layout from "@layouts/Layout.astro";
import { PROJECTS, PROJECTS_META } from "@consts";

const external = (href: string) => href.startsWith("http");
---

<Layout title={PROJECTS_META.TITLE} description={PROJECTS_META.DESCRIPTION}>
    <div class="shell">
        <header class="page-head">
            <h1>~/projects</h1>
            <p class="lede">{PROJECTS_META.DESCRIPTION}</p>
        </header>

        <ul class="grid">
            {
                PROJECTS.map((project) => (
                    <li class="card reveal">
                        <div class="card-top">
                            <h2>
                                <a
                                    href={project.HREF}
                                    target={
                                        external(project.HREF)
                                            ? "_blank"
                                            : undefined
                                    }
                                    rel={
                                        external(project.HREF)
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    {project.NAME}
                                </a>
                            </h2>
                            <span class="year">{project.YEAR}</span>
                        </div>
                        <p class="summary">{project.SUMMARY}</p>
                        <ul class="stack">
                            {project.STACK.map((tech) => (
                                <li class="tag">{tech}</li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>

<style>
    .page-head {
        padding-top: calc(var(--step) * 1.5);
        margin-bottom: calc(var(--step) * 1.5);
    }

    h1 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        color: var(--bright);
    }

    .lede {
        max-width: var(--measure);
        margin: 0.5rem 0 0;
        color: var(--base);
    }

    .grid {
        display: grid;
        gap: var(--step);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .card {
        padding: calc(var(--step) * 0.75) 2ch;
        border: 1px solid var(--line);
        background: var(--bg-raised);
    }

    .card-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 2ch;
    }

    .card h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .card h2 a {
        color: var(--bright);
        text-decoration: none;
    }

    .card h2 a::before {
        content: "› ";
        color: var(--accent);
    }

    .card h2 a:hover {
        color: var(--bg);
        background: var(--accent);
    }

    .year {
        color: var(--faint);
        font-size: 0.93em;
        font-variant-numeric: tabular-nums;
    }

    .summary {
        max-width: var(--measure);
        margin: 0.5rem 0 0;
        color: var(--dim);
    }

    .stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1ch;
        margin: 0.9rem 0 0;
        padding: 0;
        list-style: none;
    }
</style>
