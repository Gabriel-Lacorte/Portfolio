---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import { NOW } from "@consts";
---

<Layout title="Now" description="What I am working on and reading at the moment.">
  <div class="stack-gap">
    <Panel title="~/now" note={NOW.UPDATED} as="h1">
      <p class="lede">
        What has my attention at the moment. Updated when it changes, not on a
        schedule.
      </p>
    </Panel>

    <Panel title="signal" note={`${NOW.LINES.length} active`}>
      <ul class="signal">
        {
          NOW.LINES.map((line, i) => (
            <li>
              <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </Panel>
  </div>
</Layout>

<style>
  .lede {
    max-width: var(--measure);
  }

  .signal > li {
    display: flex;
    gap: 1.5ch;
    max-width: var(--measure);
  }

  .signal > li + li {
    margin-top: 0.5rem;
  }

  .idx {
    flex: none;
    color: var(--dot);
    font-variant-numeric: tabular-nums;
  }
</style>
