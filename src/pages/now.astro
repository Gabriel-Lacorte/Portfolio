---
import Layout from "@layouts/Layout.astro";
import { NOW } from "@consts";
---

<Layout
    title="Now"
    description="What I am working on and reading at the moment."
>
    <div class="shell">
        <header class="page-head">
            <h1>~/now</h1>
            <p class="lede">
                What has my attention at the moment. Updated when it changes,
                not on a schedule.
            </p>
        </header>

        <ul class="lines reveal">
            {NOW.LINES.map((line) => <li>{line}</li>)}
        </ul>

        <p class="updated">
            last updated <time datetime={NOW.UPDATED}>{NOW.UPDATED}</time>
        </p>
    </div>
</Layout>

<style>
    .page-head {
        padding-top: calc(var(--step) * 1.5);
        margin-bottom: calc(var(--step) * 1.5);
    }

    h1 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        color: var(--bright);
    }

    .lede {
        max-width: var(--measure);
        margin: 0.5rem 0 0;
        color: var(--base);
    }

    .lines {
        max-width: var(--measure);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .lines > li {
        padding-left: 3ch;
        text-indent: -3ch;
    }

    .lines > li::before {
        content: "─ ";
        color: var(--accent);
    }

    .lines > li + li {
        margin-top: 0.5rem;
    }

    .updated {
        margin-top: calc(var(--step) * 1.5);
        color: var(--faint);
        font-size: 0.93em;
    }
</style>
