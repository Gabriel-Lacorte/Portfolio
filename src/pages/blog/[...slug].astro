---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { compact, countWords, readingTime } from "@lib/stats";

export async function getStaticPaths() {
    const posts = (await getCollection("blog")).filter(
        (post) => !post.data.draft,
    );

    return posts.map((post) => ({
        params: { slug: post.slug },
        props: post,
    }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await post.render();

const iso = post.data.date.toISOString().slice(0, 10);
---

<Layout title={post.data.title} description={post.data.description}>
    <div class="stack-gap">
        <Panel title={post.data.title} note={iso} as="h1">
            <p class="summary">{post.data.description}</p>
            <Spec
                class="meta"
                rows={[
                    { k: "filed", v: iso },
                    { k: "read", v: `${readingTime(post.body)} min` },
                    { k: "words", v: compact(countWords(post.body)) },
                    ...(post.data.tags.length
                        ? [{ k: "tags", v: post.data.tags.join(" · ") }]
                        : []),
                ]}
            />
        </Panel>

        {
            headings.length > 0 && (
                <Panel title="contents" note={`${headings.length} sections`}>
                    <TableOfContents headings={headings} />
                </Panel>
            )
        }

        <div class="panel">
            <div class="panel-body">
                <article class="article">
                    <Content />
                </article>
            </div>
        </div>

        <a class="back" href="/blog">◂ back to ~/blog</a>
    </div>
</Layout>

<style>
    .summary {
        max-width: var(--measure);
        color: var(--dim);
    }

    :global(.spec.meta) {
        max-width: 52ch;
        margin-top: var(--step);
    }

    .back {
        display: inline-block;
        align-self: start;
        padding: 0.2rem 1ch;
        border: 1px solid var(--rule);
        color: var(--dim);
        font-size: 0.9em;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
</style>
