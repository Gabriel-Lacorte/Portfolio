---
import Layout from "@layouts/Layout.astro";
import { USES } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t("meta.usesTitle")} description={t("meta.usesDescription")}>
  <h1 class="sr-only">{t("meta.usesTitle")}</h1>

  <p><span class="titulo">{t("meta.usesTitle")}</span></p>
  <p>{t("meta.usesLede")}</p>

  {
    USES.map(({ GROUP, ROWS }) => (
      <>
        <p><span class="titulo">{GROUP}</span></p>
        <ul>
          {ROWS.map((row) => (
            <li>
              <b>{row.k}</b>{" "}
              {row.v.startsWith("/") ? (
                <a href={localised(row.v, locale)}>{row.v}</a>
              ) : row.v === "—" ? (
                <span class="comment">{row.v}</span>
              ) : (
                row.v
              )}
            </li>
          ))}
        </ul>
      </>
    ))
  }

  <p><br /></p>
</Layout>
