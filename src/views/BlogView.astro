---
import Layout from "@layouts/Layout.astro";
import { postsFor } from "@lib/posts";
import { compact, countWords, readingTime } from "@lib/stats";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await postsFor(locale);
const totalWords = posts.reduce((sum, p) => sum + countWords(p.body), 0);

const years = [
  ...new Set(posts.map((p) => p.data.date.getUTCFullYear())),
].sort((a, b) => b - a);

const br = (d: Date) =>
  d.toLocaleDateString("en-CA", { timeZone: "UTC" }).split("-").reverse().join("/");
---

<Layout locale={locale} title={t("meta.blogTitle")} description={t("meta.blogDescription")}>
  <h1 class="sr-only">{t("meta.blogTitle")}</h1>

  <p><span class="titulo">{t("meta.blogTitle")}</span></p>

  <p>
    {t("meta.blogDescription")}
    <br />
    <span class="comment">
      {posts.length} {t("unit.posts")} · {compact(totalWords)} {t("unit.words")}
    </span>
  </p>

  {
    years.map((year) => (
      <>
        <p><span class="titulo">{year}</span></p>
        <ul class="rows">
          {posts
            .filter((p) => p.data.date.getUTCFullYear() === year)
            .map((post) => (
              <li>
                <span class="when">[{br(post.data.date)}]</span>
                <a href={localised(`/blog/${post.data.translationKey}`, locale)}>
                  {post.data.title}
                </a>
                <span class="len">{readingTime(post.body)} min</span>
              </li>
            ))}
        </ul>
      </>
    ))
  }

  <p><br /></p>
</Layout>
