---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import { postsFor } from "@lib/posts";
import { compact, countWords, readingTime } from "@lib/stats";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await postsFor(locale);
const totalWords = posts.reduce((sum, p) => sum + countWords(p.body), 0);
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort(
    (a, b) => b - a,
);

/* ISO, the same format the asides and the windows print. The listing
   used to say 24/12/2024 while the page beside it said 2026-07-31. */
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout
    locale={locale}
    title={t("meta.blogTitle")}
    description={t("meta.blogDescription")}
>
    <Cmd
        run="ls -la"
        arg="~/writing"
        icon="note"
        as="h1"
        aside={`${posts.length} ${t("unit.posts")} · ${compact(totalWords)} ${t("unit.words")}`}
    />
    <div class="out">
        <p>{t("meta.blogDescription")}</p>
    </div>

    {
        years.map((year) => (
            <>
                <Cmd run="cd" arg={`~/writing/${year}`} icon="disk" />
                <div class="out">
                    {/* One entry per post. These used to be two separate
                        lists — every title, then every description — which
                        left the descriptions orphaned from the posts they
                        belong to. */}
                    <ol class="listing">
                        {posts
                            .filter(
                                (p) => p.data.date.getUTCFullYear() === year,
                            )
                            .map((post) => (
                                <li>
                                    <a
                                        class="head"
                                        href={localised(
                                            `/blog/${post.data.translationKey}`,
                                            locale,
                                        )}
                                    >
                                        <time
                                            class="when"
                                            datetime={post.data.date
                                                .toISOString()
                                                .slice(0, 10)}
                                        >
                                            {iso(post.data.date)}
                                        </time>
                                        <span class="title">
                                            {post.data.title}
                                        </span>
                                        <span class="len">
                                            {readingTime(post.body)} min
                                        </span>
                                    </a>
                                    <p class="desc">{post.data.description}</p>
                                    {post.data.tags.length > 0 && (
                                        <p class="tags">
                                            {post.data.tags.map((tag) => (
                                                <span class="tag">{tag}</span>
                                            ))}
                                        </p>
                                    )}
                                </li>
                            ))}
                    </ol>
                </div>
            </>
        ))
    }

</Layout>

<style>
    .listing {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .listing > li + li {
        margin-top: 14px;
    }

    .listing > li::before {
        content: none;
    }

    /* The date column is fixed so titles line up and the detail beneath
       hangs off the same edge, the way a real listing reads.

       In pixels, not ch, and deliberately: the row is set in Departure
       (9.55px per cell) while the description under it is prose in
       Iosevka (7.5px). Two elements asking for "11ch" got two different
       widths, and the description landed 23px to the left of the title
       it belongs to. One number, both places. */
    .listing {
        --datecol: 105px;
    }

    .head {
        display: grid;
        grid-template-columns: var(--datecol) minmax(0, 1fr) auto;
        gap: 0 12px;
        align-items: baseline;
        text-decoration: none;
    }

    .head .when,
    .head .len {
        color: var(--comment);
    }

    .head .title {
        color: var(--base);
        text-decoration: underline;
    }

    /* Only the title inverts on hover; lighting the whole grid row up
       swallowed the date and the reading time with it. */
    .head:hover {
        background: none;
        color: inherit;
    }

    .head:hover .title {
        color: var(--bg);
        background: var(--blood);
        text-decoration: none;
    }

    .desc,
    .tags {
        margin: 2px 0 0;
        padding-left: calc(var(--datecol) + 12px);
        color: var(--comment);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 1ch;
    }

    /* Bordered pills were three boxes per row of chrome around two words
       of metadata — cards by another name, and the system does not have
       cards. The hash carries the mark; the word stays quiet. */
    .tag {
        color: var(--comment);
        font-size: 14px;
    }

    .tag::before {
        content: "#";
        color: var(--blood);
    }

    @media (max-width: 700px) {
        .head {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .head .when {
            grid-column: 1 / -1;
        }

        .desc,
        .tags {
            padding-left: 0;
        }
    }
</style>
