---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { borrowingLocales, isFallback, localeOf, type Post } from "@lib/posts";
import { compact, countWords, readingTime } from "@lib/stats";
import { HTML_LANG } from "@i18n/ui";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale; post: Post };
const { locale, post } = Astro.props;
const t = useTranslations(locale);

const { Content, headings } = await render(post);
const iso = post.data.date.toISOString().slice(0, 10);

const borrowed = isFallback(post, locale);
const untranslated = await borrowingLocales(post);

const canonicalPath = borrowed
    ? `${localised(`/blog/${post.data.translationKey}`, localeOf(post))}/`
    : undefined;

const hasToc = headings.filter((h: { depth: number }) => h.depth <= 3).length > 1;
const bodyLang = borrowed ? HTML_LANG[localeOf(post)] : undefined;

const file = `~/writing/${localeOf(post)}/${post.data.translationKey}.md`;
---

<Layout
    locale={locale}
    title={post.data.title}
    description={post.data.description}
    untranslated={untranslated}
    canonicalPath={canonicalPath}
    article={{
        headline: post.data.title,
        published: post.data.date,
        lang: HTML_LANG[localeOf(post)],
        tags: post.data.tags,
        words: countWords(post.body ?? ""),
    }}
>
    <Cmd
        run="cat"
        arg={file}
        icon="note"
        as="h2"
        aside={`${iso} * ${readingTime(post.body ?? "")} min`}
    />

    <div class="out">
        <p>
            <b lang={bodyLang}>{post.data.title}</b>
            <br />
            <span lang={bodyLang}>{post.data.description}</span>
            <br />
            <span class="comment">
                {compact(countWords(post.body ?? ""))} {t("unit.words")}
                {post.data.tags.length > 0 && (
                    <> · {post.data.tags.join(", ")}</>
                )}
            </span>
        </p>

        {borrowed && <p class="amber">! {t("fallback.notice")}</p>}

        {
            hasToc && (
                <TableOfContents
                    headings={headings}
                    label={t("panel.contents")}
                    lang={bodyLang}
                />
            )
        }

        <article class="article" lang={bodyLang}>
            <Content />
        </article>
    </div>

    <Cmd run="cd" arg="~/writing" icon="term" />
    <div class="out">
        <p>
            <a href={localised("/blog", locale)}
                >&lt;- {t("action.backToBlog")}</a
            >
        </p>
    </div>

</Layout>
