---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { isFallback, localeOf, type Post } from "@lib/posts";
import { compact, countWords, readingTime } from "@lib/stats";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale; post: Post };
const { locale, post } = Astro.props;
const t = useTranslations(locale);

const { Content, headings } = await post.render();
const iso = post.data.date.toISOString().slice(0, 10);
const br = iso.split("-").reverse().join("/");

/* True when this locale has no translation yet and is reading the
   original. Saying so is the honest alternative to hiding the post or
   blocking publication on a translation. */
const borrowed = isFallback(post, locale);
const hasToc = headings.filter((h) => h.depth <= 3).length > 1;

/* The file the reader is notionally reading — the post's own source. */
const file = `~/writing/${localeOf(post)}/${post.data.translationKey}.md`;
---

<Layout
    locale={locale}
    title={post.data.title}
    description={post.data.description}
>
    <Cmd
        run="cat"
        arg={file}
        icon="note"
        as="h1"
        aside={`${br} · ${readingTime(post.body)} min`}
    />

    <div class="out">
        <p>
            <b>{post.data.title}</b>
            <br />
            {post.data.description}
            <br />
            <span class="comment">
                {compact(countWords(post.body))} {t("unit.words")}
                {post.data.tags.length > 0 && (
                    <> · {post.data.tags.join(", ")}</>
                )}
            </span>
        </p>

        {borrowed && <p class="amber">! {t("fallback.notice")}</p>}

        {
            hasToc && (
                <TableOfContents
                    headings={headings}
                    label={t("panel.contents")}
                />
            )
        }

        <article class="article">
            <Content />
        </article>
    </div>

    <Cmd run="cd" arg="~/writing" icon="term" />
    <div class="out">
        <p>
            <a href={localised("/blog", locale)}
                >&lt;- {t("action.backToBlog")}</a
            >
        </p>
    </div>

    <p><br /></p>
</Layout>
