---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { borrowingLocales, isFallback, localeOf, type Post } from "@lib/posts";
import { compact, countWords, readingTime } from "@lib/stats";
import { HTML_LANG } from "@i18n/ui";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale; post: Post };
const { locale, post } = Astro.props;
const t = useTranslations(locale);

const { Content, headings } = await post.render();
const iso = post.data.date.toISOString().slice(0, 10);
const br = iso.split("-").reverse().join("/");

/* True when this locale has no translation yet and is reading the
   original. Saying so is the honest alternative to hiding the post or
   blocking publication on a translation. */
const borrowed = isFallback(post, locale);

/* Which locales answer at this post's URL with someone else's language.
   A borrowed page must not tell a search engine it is the Portuguese
   article — it is the English one with a notice on top. Derived from
   the post rather than from this route, so both routes agree. */
const untranslated = await borrowingLocales(post);

/* When this route is serving the original rather than a translation of
   it, the original is the canonical. Two URLs carrying the same English
   words otherwise compete with each other for it, and the one that wins
   is a coin toss. */
const canonicalPath = borrowed
    ? `${localised(`/blog/${post.data.translationKey}`, localeOf(post))}/`
    : undefined;
const hasToc = headings.filter((h) => h.depth <= 3).length > 1;

/* A borrowed page is English text inside a page that says lang="pt-BR".
   Left unmarked, a screen reader pronounces English words with
   Portuguese phonetics and the result is not words at all. Marking the
   parts that are actually the post — title, description, contents,
   body — lets it switch voice and leaves the chrome alone. */
const bodyLang = borrowed ? HTML_LANG[localeOf(post)] : undefined;

/* The file the reader is notionally reading — the post's own source. */
const file = `~/writing/${localeOf(post)}/${post.data.translationKey}.md`;
---

<Layout
    locale={locale}
    title={post.data.title}
    description={post.data.description}
    untranslated={untranslated}
    canonicalPath={canonicalPath}
>
    <Cmd
        run="cat"
        arg={file}
        icon="note"
        as="h1"
        aside={`${br} · ${readingTime(post.body)} min`}
    />

    <div class="out">
        <p>
            <b lang={bodyLang}>{post.data.title}</b>
            <br />
            <span lang={bodyLang}>{post.data.description}</span>
            <br />
            <span class="comment">
                {compact(countWords(post.body))} {t("unit.words")}
                {post.data.tags.length > 0 && (
                    <> · {post.data.tags.join(", ")}</>
                )}
            </span>
        </p>

        {borrowed && <p class="amber">! {t("fallback.notice")}</p>}

        {
            hasToc && (
                <TableOfContents
                    headings={headings}
                    label={t("panel.contents")}
                    lang={bodyLang}
                />
            )
        }

        <article class="article" lang={bodyLang}>
            <Content />
        </article>
    </div>

    <Cmd run="cd" arg="~/writing" icon="term" />
    <div class="out">
        <p>
            <a href={localised("/blog", locale)}
                >&lt;- {t("action.backToBlog")}</a
            >
        </p>
    </div>

</Layout>
