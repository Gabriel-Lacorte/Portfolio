---
import Layout from "@layouts/Layout.astro";
import { NOW } from "@consts";
import { useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t("meta.nowTitle")} description={t("meta.nowDescription")}>
  <h1 class="sr-only">{t("meta.nowTitle")}</h1>

  <p>
    <span class="titulo">{t("meta.nowTitle")}</span>{" "}
    <span class="comment">— {NOW.UPDATED}</span>
  </p>

  <p>{t("meta.nowLede")}</p>

  <ul>
    {NOW.LINES.map((line) => <li>{line}</li>)}
  </ul>

  <p><br /></p>
</Layout>
