---
import Layout from "@layouts/Layout.astro";
import { postsFor } from "@lib/posts";
import { compact, getStats, readingTime } from "@lib/stats";
import { localised, useTranslations, type Locale } from "@i18n/utils";
import { CHANGELOG, NOW, PROJECTS, SITE, STACK_GROUPS } from "@consts";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
const L = (path: string) => localised(path, locale);

const posts = await postsFor(locale);
const stats = await getStats();

const br = (d: Date) =>
    d
        .toLocaleDateString("en-CA", { timeZone: "UTC" })
        .split("-")
        .reverse()
        .join("/");

/* Anything filed in the last 90 days carries the [new] marker. Measured
   against the build date so it is decided once, at build time. */
const NEW_FOR_DAYS = 90;
const isNew = (d: Date) =>
    (Date.parse(stats.built) - d.valueOf()) / 86_400_000 < NEW_FOR_DAYS;
---

<Layout
    locale={locale}
    title={SITE.TITLE}
    description={t("meta.homeDescription")}
    suffix={false}
    windows
>
    <h1 class="sr-only">{SITE.TITLE} — {t("site.role")}</h1>

    <p><span class="titulo">{t("home.about")}</span></p>

    <p>
        {t("home.intro1")}
        <br />
        {t("home.intro2")}
    </p>

    <p><span class="titulo">{t("home.changelog")}</span></p>

    {
        CHANGELOG.slice(0, 2).map(({ DATE, TEXT }) => (
            <p>
                <b>{br(new Date(DATE))}</b> {TEXT}
            </p>
        ))
    }

    <p><span class="titulo">{t("home.latest")}</span></p>

    <ul class="rows">
        {
            posts.map((post) => (
                <li>
                    <span class="when">[{br(post.data.date)}]</span>
                    <a href={L(`/blog/${post.data.translationKey}`)}>
                        {post.data.title}
                    </a>
                    {isNew(post.data.date) && <span class="new">[new]</span>}
                    <span class="len">{readingTime(post.body)} min</span>
                </li>
            ))
        }
    </ul>

    <p><span class="titulo">{t("home.projects")}</span></p>

    <ul>
        {
            PROJECTS.map((project) => (
                <li>
                    <a
                        href={
                            project.HREF.startsWith("http")
                                ? project.HREF
                                : L(project.HREF)
                        }
                    >
                        {project.NAME}
                    </a>{" "}
                    <span class="comment">{project.SUMMARY}</span>
                </li>
            ))
        }
    </ul>

    <p><span class="titulo">{t("home.stack")}</span></p>

    <ul>
        {
            STACK_GROUPS.map(({ GROUP, ITEMS }) => (
                <li>
                    <b>{GROUP}</b> {ITEMS.join(", ")}
                </li>
            ))
        }
    </ul>

    <p>
        <span class="titulo">{t("home.now")}</span>{" "}
        <span class="comment">— {NOW.UPDATED}</span>
    </p>

    <ul>
        {NOW.LINES.map((line) => <li>{line}</li>)}
    </ul>

    <p><br /></p>

    <Fragment slot="windows">
        <aside id="win-status" class="window" aria-label={t("win.status")}>
            <div class="window__bar">
                <span>status</span>
                <span class="window__controls">
                    <button
                        type="button"
                        data-window-close="win-status"
                        aria-label={t("win.close")}>x</button
                    >
                </span>
            </div>
            <pre class="window__body"><span class="prompt">$</span> ./status

host....... <a href="https://lacorte.city">lacorte.city</a>
status..... <span class="green">online</span>
posts...... {stats.posts}
words...... {compact(stats.words)}
build...... {stats.commit}
updated.... {stats.built}</pre>
        </aside>
    </Fragment>

    <Fragment slot="taskbar">
        <nav class="taskbar no-print" aria-label={t("win.windows")}>
            <button
                type="button"
                data-window-task="win-status"
                aria-controls="win-status"
                aria-pressed="true">status</button
            >
        </nav>
    </Fragment>
</Layout>

<style>
    /* Parked beside the column, the way the reference floats its own.
       The breakpoint is arithmetic, not a guess: the column is 984px and
       centred, so the gutter beside it is (100vw - 984) / 2. Fitting a
       340px window plus gaps needs that gutter to reach 372px, which is
       100vw >= 1728. At my earlier 1320 the window simply sat on top of
       the prose. Below the breakpoint it joins the flow. */
    @media (min-width: 1740px) {
        .window {
            position: fixed;
            top: 210px;
            right: max(16px, calc((100vw - 984px) / 2 - 356px));
            margin: 0;
        }
    }
</style>
