---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import Masthead from "@components/Masthead.astro";
import { postsFor } from "@lib/posts";
import { compact, getStats, readingTime } from "@lib/stats";
import { localised, useTranslations, type Locale } from "@i18n/utils";
import {
    CHANGELOG,
    LAB,
    NOW,
    PROJECTS,
    READING,
    SITE,
    STACK_GROUPS,
} from "@consts";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
const L = (path: string) => localised(path, locale);

const posts = await postsFor(locale);
const stats = await getStats();

const br = (d: Date) =>
    d
        .toLocaleDateString("en-CA", { timeZone: "UTC" })
        .split("-")
        .reverse()
        .join("/");

/* Anything filed in the last 90 days carries the [new] marker, decided
   once against the build date. */
const NEW_FOR_DAYS = 90;
const isNew = (d: Date) =>
    (Date.parse(stats.built) - d.valueOf()) / 86_400_000 < NEW_FOR_DAYS;
---

<Layout
    locale={locale}
    title={SITE.TITLE}
    description={t("meta.homeDescription")}
    suffix={false}
    windows
>
    <Masthead slot="ident" tagline={t("site.tagline")} />

    <h1 class="sr-only">{SITE.TITLE} — {t("site.role")}</h1>

    <Cmd run="whoami" icon="term" />
    <div class="out">
        <p>
            {t("home.intro1")}
            <br />
            {t("home.intro2")}
        </p>
    </div>

    <Cmd run="ls -la" arg="~/writing" icon="note" aside={`${posts.length} ${t("unit.posts")} · ${compact(stats.words)} ${t("unit.words")}`} />
    <div class="out">
        <ul class="rows">
            {
                posts.map((post) => (
                    <li>
                        <span class="when">{br(post.data.date)}</span>
                        <a href={L(`/blog/${post.data.translationKey}`)}
                            >{post.data.title}</a
                        >
                        {isNew(post.data.date) && (
                            <span class="new">[new]</span>
                        )}
                        <span class="len">{readingTime(post.body)} min</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <Cmd run="systemctl status" arg="lab" icon="disk" />
    <div class="out">
        <ul class="boxes">
            {
                LAB.map(({ NAME, ROLE, SPEC, OS, STATE }) => (
                    <li>
                        <span class="bname">{NAME}</span>{" "}
                        <span class="state" data-s={STATE}>
                            ● {STATE}
                        </span>{" "}
                        <span class="comment">
                            {ROLE} · {OS} · {SPEC}
                        </span>
                    </li>
                ))
            }
        </ul>
    </div>

    <Cmd run="cat" arg="~/.config/stack" icon="chip" />
    <div class="out">
        <ul>
            {
                STACK_GROUPS.map(({ GROUP, ITEMS }) => (
                    <li>
                        <b>{GROUP}</b> {ITEMS.join(", ")}
                    </li>
                ))
            }
        </ul>
    </div>

    <Cmd run="ls" arg="~/projects" icon="star" />
    <div class="out">
        <ul>
            {
                PROJECTS.map((project) => (
                    <li>
                        <a
                            href={
                                project.HREF.startsWith("http")
                                    ? project.HREF
                                    : L(project.HREF)
                            }
                            >{project.NAME}</a
                        >{" "}
                        <span class="comment">{project.SUMMARY}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <Cmd run="cat" arg="~/reading" icon="book" />
    <div class="out">
        <ul>
            {
                READING.map(({ TITLE, NOTE, STATE }) => (
                    <li>
                        <span class:list={[STATE === "now" && "purple"]}>
                            {TITLE}
                        </span>{" "}
                        <span class="comment">— {NOTE}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <Cmd run="tail" arg="~/now" icon="term" aside={NOW.UPDATED} />
    <div class="out">
        <ul>
            {NOW.LINES.map((line) => <li>{line}</li>)}
        </ul>
    </div>

    <Cmd run="git log" arg="--oneline" icon="warn" />
    <div class="out">
        <ul class="rows">
            {
                CHANGELOG.map(({ DATE, TEXT }) => (
                    <li>
                        <span class="when">{br(new Date(DATE))}</span>
                        <span>{TEXT}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <p><br /></p>

    <Fragment slot="windows">
        <aside id="win-status" class="window" aria-label={t("win.status")}>
            <div class="window__bar">
                <span>status</span>
                <span class="window__controls">
                    <button
                        type="button"
                        data-window-close="win-status"
                        aria-label={t("win.close")}>x</button
                    >
                </span>
            </div>
            <pre class="window__body"><span class="prompt">$</span> ./status

host....... <a href="https://lacorte.city">lacorte.city</a>
status..... <span class="green">online</span>
posts...... {stats.posts}
words...... {compact(stats.words)}
build...... {stats.commit}
updated.... {stats.built}</pre>
        </aside>

        <aside id="win-lab" class="window" aria-label={t("win.lab")}>
            <div class="window__bar">
                <span>lab</span>
                <span class="window__controls">
                    <button
                        type="button"
                        data-window-close="win-lab"
                        aria-label={t("win.close")}>x</button
                    >
                </span>
            </div>
            <pre
                class="window__body"><span class="prompt">$</span> systemctl status lab
{LAB.map((b) => `${b.NAME.padEnd(12, ".")} ${b.STATE}`).join("\n")}

ingress..... cloudflare tunnel
open ports.. <span class="green">none</span></pre>
        </aside>
    </Fragment>

    <Fragment slot="taskbar">
        <nav class="taskbar no-print" aria-label={t("win.windows")}>
            <button
                type="button"
                data-window-task="win-status"
                aria-controls="win-status"
                aria-pressed="true">status</button
            >
            <button
                type="button"
                data-window-task="win-lab"
                aria-controls="win-lab"
                aria-pressed="true">lab</button
            >
        </nav>
    </Fragment>
</Layout>

<style>
    /* No floating rules here any more: the script lifts the windows once,
       at a known position, above 900px. Leaving a media query to do it as
       well meant CSS and JS disagreed about where a window was, and a
       restored position never matched. In the flow is the no-script
       fallback. */
    .window {
        max-width: 100%;
    }
</style>
