---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import { PROJECTS } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);

const external = (href: string) => href.startsWith("http");
---

<Layout
    locale={locale}
    title={t("meta.projectsTitle")}
    description={t("meta.projectsDescription")}
  >
  <div class="stack-gap">
    <Panel title="~/projects" note={`${PROJECTS.length} ${t("unit.listed")}`} as="h1">
      <p class="lede">{t("meta.projectsDescription")}</p>
    </Panel>

    {
      PROJECTS.map((project) => (
        <Panel title={project.NAME} note={project.YEAR}>
          <p class="summary">{project.SUMMARY}</p>
          <Spec
            class="kit"
            rows={[
              { k: t("field.stack"), v: project.STACK.join(" · ") },
              {
                k: t("field.source"),
                v: external(project.HREF) ? "github" : "writeup",
                href: external(project.HREF) ? project.HREF : localised(project.HREF, locale),
                external: external(project.HREF),
              },
            ]}
          />
        </Panel>
      ))
    }
  </div>
</Layout>

<style>
  .lede,
  .summary {
    max-width: var(--measure);
  }

  .summary {
    color: var(--dim);
  }

  :global(.spec.kit) {
    margin-top: var(--step);
  }
</style>
