---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import { PROJECTS } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
const external = (href: string) => href.startsWith("http");
---

<Layout
  locale={locale}
  title={t("meta.projectsTitle")}
  description={t("meta.projectsDescription")}
>
  <h1 class="sr-only">{t("meta.projectsTitle")}</h1>

  <Cmd
    run="ls -la"
    arg="~/projects"
    icon="star"
    aside={`${PROJECTS.length} ${t("unit.listed")}`}
  />
  <div class="out">
    <p>{t("meta.projectsDescription")}</p>
  </div>

  {
    PROJECTS.map((project) => (
      <>
        <Cmd run="cat" arg={`~/projects/${project.NAME}/README`} icon="book" aside={project.YEAR} />
        <div class="out">
          <p>
            {project.SUMMARY}
            <br />
            <span class="comment">{project.STACK.join(", ")}</span>
            <br />
            <a
              href={external(project.HREF) ? project.HREF : localised(project.HREF, locale)}
              target={external(project.HREF) ? "_blank" : undefined}
              rel={external(project.HREF) ? "noopener noreferrer" : undefined}
            >
              {external(project.HREF) ? t("field.source") : t("field.writeup")} -&gt;
            </a>
          </p>
        </div>
      </>
    ))
  }

  <p><br /></p>
</Layout>
