---
import Layout from "@layouts/Layout.astro";
import Panel from "@components/ascii/Panel.astro";
import Spec from "@components/ascii/Spec.astro";
import Dither from "@components/ascii/Dither.astro";
import { NAV_KEYS } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t("err.title")} description={t("err.description")} suffix={false}>
  <div class="stack-gap">
    <Panel title={t("panel.fault")} note="err 404" as="h1">
      <Dither pattern="check" />
      <p class="msg">
        <code>{Astro.url.pathname}</code> {t("err.body")}
      </p>
      <Dither pattern="check" />
    </Panel>

    <Panel title={t("panel.recover")} note={`${NAV_KEYS.length} ${t("unit.routes")}`}>
      <Spec
        rows={NAV_KEYS.map(({ KEY, HREF }) => ({
          k: t(KEY),
          v: localised(HREF, locale),
          href: localised(HREF, locale),
        }))}
      />
    </Panel>
  </div>
</Layout>

<style>
  .msg {
    max-width: var(--measure);
    margin-block: var(--step);
  }

  code {
    padding: 0.05em 0.5ch;
    border: 1px solid var(--rule);
    color: var(--bright);
    overflow-wrap: anywhere;
  }
</style>
