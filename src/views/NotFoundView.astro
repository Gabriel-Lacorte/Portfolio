---
import Layout from "@layouts/Layout.astro";
import { NAV_KEYS } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t("err.title")} description={t("err.description")} suffix={false}>
  <h1 class="sr-only">{t("err.title")}</h1>

  <p><span class="titulo">404</span></p>

  <p>
    <span class="red">{Astro.url.pathname}</span> {t("err.body")}
  </p>

  <ul>
    {
      NAV_KEYS.map(({ KEY, HREF }) => (
        <li>
          <a href={localised(HREF, locale)}>{t(KEY)}</a>
        </li>
      ))
    }
  </ul>

  <p><br /></p>
</Layout>
