---
import Layout from "@layouts/Layout.astro";
import Cmd from "@components/Cmd.astro";
import { NAV_KEYS } from "@consts";
import { localised, useTranslations, type Locale } from "@i18n/utils";

type Props = { locale: Locale };
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  locale={locale}
  title={t("err.title")}
  description={t("err.description")}
  suffix={false}
  noindex
>
  <h1 class="sr-only">{t("err.title")}</h1>

  {/* The page is the command that failed. It is the one place where the
      conceit lands exactly on the real thing. */}
  <Cmd run="cat" arg={`.${Astro.url.pathname}`} icon="warn" />
  <div class="out">
    <p>
      <span class="red">cat: {Astro.url.pathname}: {t("err.noent")}</span>
      <br />
      <span class="comment">{t("err.body")}</span>
    </p>
  </div>

  <Cmd run="ls" arg="~/" icon="term" />
  <div class="out">
    <ul>
      {
        NAV_KEYS.map(({ KEY, HREF }) => (
          <li>
            <a href={localised(HREF, locale)}>{t(KEY)}</a>
          </li>
        ))
      }
    </ul>
  </div>

</Layout>
