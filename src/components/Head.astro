---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";
import { DEFAULT_LOCALE, HTML_LANG, LOCALES } from "@i18n/ui";
import { localised, unlocalised, type Locale } from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;

    untranslated?: Locale[];
    noindex?: boolean;
    canonicalPath?: string;

    article?: {
        headline: string;
        published: Date;
        lang: string;
        tags?: string[];
        words?: number;
    };
};

const {
    locale,
    title,
    description,
    untranslated = [],
    noindex = false,
    canonicalPath,
    article,
} = Astro.props;
const canonical = new URL(
    canonicalPath ?? Astro.url.pathname,
    Astro.site ?? Astro.url,
).href;

const here = unlocalised(Astro.url.pathname);
const base = Astro.site ?? Astro.url;

/* Social cards need an absolute URL; the card itself is the wordmark rendered
   in the site's own fonts, regenerated from public/_og-card.html. */
const ogImage = new URL("/og.png", base).href;
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const urlFor = (code: Locale) =>
    new URL(withSlash(localised(here, code)), base).href;

const alternates = LOCALES.filter((code) => !untranslated.includes(code)).map(
    (code) => ({ hreflang: HTML_LANG[code], href: urlFor(code) }),
);

const jsonLd = article
    ? {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          headline: article.headline,
          description,
          inLanguage: article.lang,
          datePublished: article.published.toISOString().slice(0, 10),
          mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
          author: {
              "@type": "Person",
              name: SITE.TITLE,
              url: (Astro.site ?? Astro.url).origin + "/",
          },
          ...(article.tags?.length
              ? { keywords: article.tags.join(", ") }
              : {}),
          ...(article.words ? { wordCount: article.words } : {}),
      }
    : null;

/* JSON.stringify leaves "<" alone, so a "</script>" anywhere in a post's
   title, description, or tags would close this tag and let the rest of the
   string be parsed as markup. Escaping the three characters that can start a
   tag or an entity keeps the payload valid JSON and inert. U+2028/U+2029 are
   legal in JSON but terminate a line in JavaScript, so they go too. */
const JSON_LD_ESCAPES: Record<string, string> = {
    "<": "\\u003c",
    ">": "\\u003e",
    "&": "\\u0026",
    "\u2028": "\\u2028",
    "\u2029": "\\u2029",
};

const jsonLdSafe = jsonLd
    ? JSON.stringify(jsonLd).replace(
          /[<>&\u2028\u2029]/g,
          (c) => JSON_LD_ESCAPES[c] ?? c,
      )
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0a0507" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
    !noindex &&
        alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
        ))
}
{
    !noindex && (
        <link
            rel="alternate"
            hreflang="x-default"
            href={urlFor(DEFAULT_LOCALE)}
        />
    )
}
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.HANDLE}
    href={localised("/feed.xml", locale)}
/>

<meta property="og:type" content="website" />
{
    LOCALES.filter(
        (code) => code !== locale && !untranslated.includes(code),
    ).map((code) => (
        <meta
            property="og:locale:alternate"
            content={HTML_LANG[code].replace("-", "_")}
        />
    ))
}
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.HANDLE} — ${SITE.ROLE}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
    jsonLdSafe && !noindex && (
        <script is:inline type="application/ld+json" set:html={jsonLdSafe} />
    )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<link
    rel="preload"
    href="/fonts/iosevka-400.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link
    rel="preload"
    href="/fonts/departure-mono.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>

<ClientRouter />

<script is:inline>
    /* Marks the document as scripted before first paint, so the styles that
       only make sense with JS (window chrome, taskbar) never flash. */
    document.documentElement.classList.add("js");
</script>

<script>
    type UIStrings = {
        copy: string;
        copied: string;
        copyFailed: string;
        copyLabel: string;
        moveHint: string;
    };

    /** Labels for anything the script builds, in the page's own language. */
    function strings(): UIStrings {
        try {
            return JSON.parse(document.body.dataset.ui ?? "{}");
        } catch {
            return {} as UIStrings;
        }
    }

    function codeBlocks() {
        const ui = strings();
        document
            .querySelectorAll<HTMLPreElement>(".article pre:not(.ascii)")
            .forEach((pre) => {
                if (pre.parentElement?.classList.contains("code-wrap")) return;

                const wrap = document.createElement("div");
                wrap.className = "code-wrap";
                pre.replaceWith(wrap);

                const bar = document.createElement("div");
                bar.className = "code-bar";

                const lang = document.createElement("span");
                lang.textContent =
                    pre.dataset.language && pre.dataset.language !== "plaintext"
                        ? pre.dataset.language
                        : "text";
                bar.append(lang);

                const button = document.createElement("button");
                button.type = "button";
                button.className = "code-copy";
                button.textContent = ui.copy;
                button.setAttribute("aria-label", ui.copyLabel);
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pre.innerText);
                        button.textContent = ui.copied;
                    } catch {
                        button.textContent = ui.copyFailed;
                    }
                    setTimeout(() => (button.textContent = ui.copy), 1600);
                });
                bar.append(button);

                wrap.append(bar, pre);
            });
    }

    const POS_KEY = "win:pos";
    const OPEN_KEY = "win:open";
    const WIN_W = 280;
    const GAP = 24;

    type Pos = { x: number; y: number };

    function readPositions(): Record<string, Pos> {
        try {
            return JSON.parse(localStorage.getItem(POS_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function savePosition(id: string, pos: Pos) {
        const all = readPositions();
        all[id] = pos;
        try {
            localStorage.setItem(POS_KEY, JSON.stringify(all));
        } catch {
            /*  */
        }
    }

    function readOpen(): Record<string, boolean> {
        try {
            return JSON.parse(localStorage.getItem(OPEN_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function saveOpen(id: string, open: boolean) {
        const all = readOpen();
        all[id] = open;
        try {
            localStorage.setItem(OPEN_KEY, JSON.stringify(all));
        } catch {
            /*  */
        }
    }

    function windows(signal: AbortSignal) {
        const wins = [...document.querySelectorAll<HTMLElement>(".window")];
        if (!wins.length) return;

        const ui = strings();
        const tray = document.querySelector<HTMLElement>(".taskbar");
        let top = 50;

        /* The column is the page; windows live in the margins beside it and
           must never cover it. Both are measured, so the layout decides when
           there is room to float rather than a constant that goes stale the
           moment the column width changes. */
        function margins() {
            const main = document.querySelector("main");
            if (!main) return null;
            const r = main.getBoundingClientRect();
            const room = document.documentElement.clientWidth;
            return { left: r.left, right: room - r.right, room };
        }

        const floats = () => {
            const m = margins();
            return !!m && Math.min(m.left, m.right) >= WIN_W + 2 * GAP;
        };

        const clamp = (win: HTMLElement, x: number, y: number): Pos => {
            const room = document.documentElement.clientWidth;
            const maxX = Math.max(0, room - win.offsetWidth);
            const maxY = Math.max(0, window.innerHeight - win.offsetHeight);
            return {
                x: Math.min(Math.max(0, x), maxX),
                y: Math.min(Math.max(0, y), maxY),
            };
        };

        const place = (win: HTMLElement, x: number, y: number) => {
            const p = clamp(win, x, y);
            win.style.left = `${p.x}px`;
            win.style.top = `${p.y}px`;
            return p;
        };

        /* Alternating margins, top down, so two windows never stack on one
           side and neither can land on the column. Both sides park against
           the column rather than the screen edge, so the pair stays with the
           text instead of drifting into the corners on a wide monitor. */
        function parking(win: HTMLElement, i: number): Pos {
            const m = margins();
            const width = win.offsetWidth || WIN_W;
            const y = 190 + i * 250;
            if (!m) return { x: GAP, y };
            const x =
                i % 2 === 0
                    ? Math.max(GAP, m.left - width - GAP)
                    : Math.min(m.room - width - GAP, m.room - m.right + GAP);
            return { x, y };
        }

        function buriesColumn(win: HTMLElement) {
            const main = document.querySelector("main");
            if (!main) return false;
            const m = main.getBoundingClientRect();
            const r = win.getBoundingClientRect();
            return r.right > m.left && r.left < m.right;
        }

        /* Also heals positions saved by an earlier build that parked on top
           of the column. */
        function repark(win: HTMLElement, i: number) {
            if (!buriesColumn(win)) return;
            const p = parking(win, i);
            place(win, p.x, p.y);
            savePosition(win.id, p);
        }

        const setOpen = (id: string, open: boolean, persist = true) => {
            const win = document.getElementById(id);
            const task = tray?.querySelector<HTMLButtonElement>(
                `[data-window-task="${id}"]`,
            );
            if (win) win.hidden = !open;
            task?.setAttribute("aria-pressed", String(open));
            if (persist) saveOpen(id, open);
            if (!open || !win) return;
            if (win.style.position === "fixed") {
                place(win, parseFloat(win.style.left), parseFloat(win.style.top));
                repark(win, wins.indexOf(win));
            } else win.scrollIntoView({ block: "nearest" });
        };

        /* Built from the windows on the page so the two cannot drift, and so
           closing one is always reversible. */
        function buildTray() {
            if (!tray || tray.childElementCount) return;
            for (const win of wins) {
                const button = document.createElement("button");
                button.type = "button";
                button.dataset.windowTask = win.id;
                button.textContent =
                    win
                        .querySelector(".window__bar > span")
                        ?.textContent?.trim() || win.id;
                button.setAttribute("aria-pressed", String(!win.hidden));
                button.addEventListener("click", () =>
                    setOpen(
                        win.id,
                        button.getAttribute("aria-pressed") !== "true",
                    ),
                );
                tray.append(button);
            }
        }

        document
            .querySelectorAll<HTMLButtonElement>("[data-window-close]")
            .forEach((b) =>
                b.addEventListener("click", () =>
                    setOpen(b.dataset.windowClose!, false),
                ),
            );

        const lift = (win: HTMLElement, i: number) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (!bar || win.style.position === "fixed") return;

            win.style.position = "fixed";
            win.style.margin = "0";
            win.style.width = `${Math.min(
                WIN_W,
                document.documentElement.clientWidth - 32,
            )}px`;
            win.style.zIndex = String(++top);

            const start = readPositions()[win.id] ?? parking(win, i);
            place(win, start.x, start.y);

            bar.tabIndex = 0;
            bar.setAttribute("role", "application");
            bar.setAttribute("aria-roledescription", ui.moveHint);
            /* Without this the bar takes its name from its own contents and
               announces as "status x", the close button's label included. */
            const named = win.getAttribute("aria-label");
            if (named) bar.setAttribute("aria-label", named);
        };

        const drop = (win: HTMLElement) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (win.style.position !== "fixed") return;

            for (const p of [
                "position",
                "left",
                "top",
                "width",
                "margin",
                "z-index",
            ])
                win.style.removeProperty(p);

            bar?.removeAttribute("tabindex");
            bar?.removeAttribute("role");
            bar?.removeAttribute("aria-roledescription");
        };

        const sync = () => {
            const floating = floats();
            document.documentElement.classList.toggle("floating", floating);

            wins.forEach((win, i) => {
                /* Inline, a window is an ordinary aside with no close control,
                   so a closed one has to come back or it is lost for good. */
                win.hidden = false;
                if (!floating) return drop(win);
                lift(win, i);
                place(
                    win,
                    parseFloat(win.style.left),
                    parseFloat(win.style.top),
                );
                repark(win, i);
            });

            if (!floating) return;
            buildTray();
            const open = readOpen();
            wins.forEach((win) =>
                setOpen(win.id, open[win.id] !== false, false),
            );
        };

        wins.forEach((win) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (!bar) return;

            bar.addEventListener("pointerdown", (e) => {
                if (win.style.position !== "fixed") return;
                if ((e.target as HTMLElement).closest("button")) return;
                e.preventDefault();
                win.style.zIndex = String(++top);

                const r = win.getBoundingClientRect();
                const dx = e.clientX - r.left;
                const dy = e.clientY - r.top;
                bar.setPointerCapture(e.pointerId);
                bar.dataset.dragging = "1";

                const move = (ev: PointerEvent) =>
                    place(win, ev.clientX - dx, ev.clientY - dy);

                const up = (ev: PointerEvent) => {
                    delete bar.dataset.dragging;
                    bar.releasePointerCapture(ev.pointerId);
                    bar.removeEventListener("pointermove", move);
                    bar.removeEventListener("pointerup", up);
                    savePosition(win.id, {
                        x: parseFloat(win.style.left),
                        y: parseFloat(win.style.top),
                    });
                };

                bar.addEventListener("pointermove", move);
                bar.addEventListener("pointerup", up);
            });

            bar.addEventListener("keydown", (e) => {
                if (win.style.position !== "fixed") return;
                const step = e.shiftKey ? 4 : 16;
                const by: Record<string, [number, number]> = {
                    ArrowLeft: [-step, 0],
                    ArrowRight: [step, 0],
                    ArrowUp: [0, -step],
                    ArrowDown: [0, step],
                };
                const d = by[e.key];
                if (!d) return;
                e.preventDefault();
                win.style.zIndex = String(++top);
                savePosition(
                    win.id,
                    place(
                        win,
                        parseFloat(win.style.left) + d[0],
                        parseFloat(win.style.top) + d[1],
                    ),
                );
            });
        });

        sync();

        window.addEventListener("resize", sync, { signal });
    }

    /* One controller per navigation: the router swaps the document but leaves
       window-level listeners behind, so each one is torn down before the next
       page wires its own. */
    let page: AbortController | undefined;

    function init() {
        page?.abort();
        page = new AbortController();
        codeBlocks();
        windows(page.signal);
    }

    document.addEventListener("astro:page-load", init);
</script>
