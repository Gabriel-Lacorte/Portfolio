---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";
import { DEFAULT_LOCALE, HTML_LANG, LOCALES } from "@i18n/ui";
import { localised, unlocalised, type Locale } from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;

    untranslated?: Locale[];
    noindex?: boolean;
    canonicalPath?: string;

    article?: {
        headline: string;
        published: Date;
        lang: string;
        tags?: string[];
        words?: number;
    };
};

const {
    locale,
    title,
    description,
    untranslated = [],
    noindex = false,
    canonicalPath,
    article,
} = Astro.props;
const canonical = new URL(
    canonicalPath ?? Astro.url.pathname,
    Astro.site ?? Astro.url,
).href;

const here = unlocalised(Astro.url.pathname);
const base = Astro.site ?? Astro.url;

const ogImage = new URL("/og.png", base).href;
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const urlFor = (code: Locale) =>
    new URL(withSlash(localised(here, code)), base).href;

const alternates = LOCALES.filter((code) => !untranslated.includes(code)).map(
    (code) => ({ hreflang: HTML_LANG[code], href: urlFor(code) }),
);

const jsonLd = article
    ? {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          headline: article.headline,
          description,
          inLanguage: article.lang,
          datePublished: article.published.toISOString().slice(0, 10),
          mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
          author: {
              "@type": "Person",
              name: SITE.TITLE,
              url: (Astro.site ?? Astro.url).origin + "/",
          },
          ...(article.tags?.length
              ? { keywords: article.tags.join(", ") }
              : {}),
          ...(article.words ? { wordCount: article.words } : {}),
      }
    : null;

/* JSON.stringify does not escape "<", so a "</script>" in any field would
   close this tag. U+2028/U+2029 are valid JSON but end a line in JS. */
const JSON_LD_ESCAPES: Record<string, string> = {
    "<": "\\u003c",
    ">": "\\u003e",
    "&": "\\u0026",
    "\u2028": "\\u2028",
    "\u2029": "\\u2029",
};

const jsonLdSafe = jsonLd
    ? JSON.stringify(jsonLd).replace(
          /[<>&\u2028\u2029]/g,
          (c) => JSON_LD_ESCAPES[c] ?? c,
      )
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#060606" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
    !noindex &&
        alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
        ))
}
{
    !noindex && (
        <link
            rel="alternate"
            hreflang="x-default"
            href={urlFor(DEFAULT_LOCALE)}
        />
    )
}
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.HANDLE}
    href={localised("/feed.xml", locale)}
/>

<meta property="og:type" content="website" />
{
    LOCALES.filter(
        (code) => code !== locale && !untranslated.includes(code),
    ).map((code) => (
        <meta
            property="og:locale:alternate"
            content={HTML_LANG[code].replace("-", "_")}
        />
    ))
}
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.HANDLE} — ${SITE.ROLE}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
    jsonLdSafe && !noindex && (
        <script is:inline type="application/ld+json" set:html={jsonLdSafe} />
    )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<link
    rel="preload"
    href="/fonts/iosevka-400.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link
    rel="preload"
    href="/fonts/departure-mono.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>

<ClientRouter />

<script is:inline>
    document.documentElement.classList.add("js");
    document.addEventListener(
        "keydown",
        (e) => {
            if (e.key === "Delete") window.__delEarly = true;
        },
        true,
    );
</script>

