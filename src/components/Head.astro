---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "@consts";
import { DEFAULT_LOCALE, HTML_LANG, LOCALES } from "@i18n/ui";
import { localised, unlocalised, type Locale } from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;

    untranslated?: Locale[];
    noindex?: boolean;
    canonicalPath?: string;

    article?: {
        headline: string;
        published: Date;
        lang: string;
        tags?: string[];
        words?: number;
    };
};

const {
    locale,
    title,
    description,
    untranslated = [],
    noindex = false,
    canonicalPath,
    article,
} = Astro.props;
const canonical = new URL(
    canonicalPath ?? Astro.url.pathname,
    Astro.site ?? Astro.url,
).href;

const here = unlocalised(Astro.url.pathname);
const base = Astro.site ?? Astro.url;
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const urlFor = (code: Locale) =>
    new URL(withSlash(localised(here, code)), base).href;

const alternates = LOCALES.filter((code) => !untranslated.includes(code)).map(
    (code) => ({ hreflang: HTML_LANG[code], href: urlFor(code) }),
);

const jsonLd = article
    ? {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          headline: article.headline,
          description,
          inLanguage: article.lang,
          datePublished: article.published.toISOString().slice(0, 10),
          mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
          author: {
              "@type": "Person",
              name: SITE.TITLE,
              url: (Astro.site ?? Astro.url).origin + "/",
          },
          ...(article.tags?.length
              ? { keywords: article.tags.join(", ") }
              : {}),
          ...(article.words ? { wordCount: article.words } : {}),
      }
    : null;

/* JSON.stringify leaves "<" alone, so a "</script>" anywhere in a post's
   title, description, or tags would close this tag and let the rest of the
   string be parsed as markup. Escaping the characters that can start a tag
   or an entity keeps the payload valid JSON and inert. U+2028/U+2029 are
   legal in JSON but terminate a line in JavaScript, so they go too. */
const JSON_LD_ESCAPES: Record<string, string> = {
    "<": "\\u003c",
    ">": "\\u003e",
    "&": "\\u0026",
    "\u2028": "\\u2028",
    "\u2029": "\\u2029",
};

const jsonLdSafe = jsonLd
    ? JSON.stringify(jsonLd).replace(
          /[<>&\u2028\u2029]/g,
          (c) => JSON_LD_ESCAPES[c] ?? c,
      )
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0a0507" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
    !noindex &&
        alternates.map(({ hreflang, href }) => (
            <link rel="alternate" hreflang={hreflang} href={href} />
        ))
}
{
    !noindex && (
        <link
            rel="alternate"
            hreflang="x-default"
            href={urlFor(DEFAULT_LOCALE)}
        />
    )
}
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.HANDLE}
    href={localised("/feed.xml", locale)}
/>

<meta property="og:type" content="website" />
{
    LOCALES.filter(
        (code) => code !== locale && !untranslated.includes(code),
    ).map((code) => (
        <meta
            property="og:locale:alternate"
            content={HTML_LANG[code].replace("-", "_")}
        />
    ))
}
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{
    jsonLdSafe && !noindex && (
        <script is:inline type="application/ld+json" set:html={jsonLdSafe} />
    )
}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<link
    rel="preload"
    href="/fonts/iosevka-400.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link
    rel="preload"
    href="/fonts/departure-mono.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>

<ClientRouter />

<script is:inline>
    (() => {
        const root = document.documentElement;
        root.classList.add("js");
        root.classList.toggle(
            "light",
            localStorage.getItem("theme") === "light",
        );
    })();
</script>

<script>
    function codeBlocks() {
        document
            .querySelectorAll<HTMLPreElement>(".article pre:not(.ascii)")
            .forEach((pre) => {
                if (pre.parentElement?.classList.contains("code-wrap")) return;

                const wrap = document.createElement("div");
                wrap.className = "code-wrap";
                pre.replaceWith(wrap);

                const bar = document.createElement("div");
                bar.className = "code-bar";

                const lang = document.createElement("span");
                lang.textContent =
                    pre.dataset.language && pre.dataset.language !== "plaintext"
                        ? pre.dataset.language
                        : "text";
                bar.append(lang);

                const button = document.createElement("button");
                button.type = "button";
                button.className = "code-copy";
                button.textContent = "copy";
                button.setAttribute("aria-label", "Copy code to clipboard");
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pre.innerText);
                        button.textContent = "copied";
                    } catch {
                        button.textContent = "failed";
                    }
                    setTimeout(() => (button.textContent = "copy"), 1600);
                });
                bar.append(button);

                wrap.append(bar, pre);
            });
    }

    const POS_KEY = "win:pos";
    const OPEN_KEY = "win:open";
    const COLUMN = 984;
    const WIN_W = 280;
    const GAP = 24;
    const FLOAT_FROM = COLUMN + 2 * (WIN_W + GAP);

    const MOVE_HINT = document.documentElement.lang.startsWith("pt")
        ? "janela, setas movem"
        : "window, arrow keys move";

    type Pos = { x: number; y: number };

    function readPositions(): Record<string, Pos> {
        try {
            return JSON.parse(localStorage.getItem(POS_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function savePosition(id: string, pos: Pos) {
        const all = readPositions();
        all[id] = pos;
        try {
            localStorage.setItem(POS_KEY, JSON.stringify(all));
        } catch {
            /*  */
        }
    }

    function readOpen(): Record<string, boolean> {
        try {
            return JSON.parse(localStorage.getItem(OPEN_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function saveOpen(id: string, open: boolean) {
        const all = readOpen();
        all[id] = open;
        try {
            localStorage.setItem(OPEN_KEY, JSON.stringify(all));
        } catch {
            /*  */
        }
    }

    function windows() {
        const wins = [...document.querySelectorAll<HTMLElement>(".window")];
        if (!wins.length) return;

        const setOpen = (id: string, open: boolean, persist = true) => {
            const win = document.getElementById(id);
            const task = document.querySelector<HTMLButtonElement>(
                `[data-window-task="${id}"]`,
            );
            if (win) win.hidden = !open;
            task?.setAttribute("aria-pressed", String(open));
            if (persist) saveOpen(id, open);
            if (!open || !win) return;
            if (win.style.position === "fixed") repark(win);
            else win.scrollIntoView({ block: "nearest" });
        };

        function repark(win: HTMLElement) {
            if (!buriesColumn(win)) return;
            const p = parking(win, wins.indexOf(win));
            place(win, p.x, p.y);
            savePosition(win.id, p);
        }

        document
            .querySelectorAll<HTMLButtonElement>("[data-window-close]")
            .forEach((b) =>
                b.addEventListener("click", () =>
                    setOpen(b.dataset.windowClose!, false),
                ),
            );

        document
            .querySelectorAll<HTMLButtonElement>("[data-window-task]")
            .forEach((b) =>
                b.addEventListener("click", () => {
                    const id = b.dataset.windowTask!;
                    setOpen(id, b.getAttribute("aria-pressed") !== "true");
                }),
            );

        const openState = readOpen();
        wins.forEach((win) => {
            if (openState[win.id] === false) setOpen(win.id, false, false);
        });

        const saved = readPositions();
        let top = 50;

        const clamp = (win: HTMLElement, x: number, y: number): Pos => {
            const maxX = Math.max(0, window.innerWidth - win.offsetWidth);
            const maxY = Math.max(0, window.innerHeight - win.offsetHeight);
            return {
                x: Math.min(Math.max(0, x), maxX),
                y: Math.min(Math.max(0, y), maxY),
            };
        };

        const place = (win: HTMLElement, x: number, y: number) => {
            const p = clamp(win, x, y);
            win.style.left = `${p.x}px`;
            win.style.top = `${p.y}px`;
            return p;
        };

        function parking(win: HTMLElement, i: number): Pos {
            const width = win.offsetWidth || WIN_W;
            if (win.id === "win-status") {
                return { x: GAP + 140, y: 190 };
            }
            if (win.id === "win-lab") {
                return {
                    x: Math.max(GAP, window.innerWidth - width - 150),
                    y: 440,
                };
            }
            return {
                x: Math.max(GAP, window.innerWidth - width - GAP),
                y: 96 + i * 220,
            };
        }

        function buriesColumn(win: HTMLElement) {
            const main = document.querySelector("main");
            if (!main) return false;
            const m = main.getBoundingClientRect();
            const r = win.getBoundingClientRect();
            return r.right > m.left && r.left < m.right;
        }

        const floats = () => window.innerWidth >= FLOAT_FROM;

        const lift = (win: HTMLElement, i: number) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (!bar || win.style.position === "fixed") return;

            win.style.position = "fixed";
            win.style.margin = "0";
            win.style.width = `${Math.min(WIN_W, window.innerWidth - 32)}px`;
            win.style.zIndex = String(++top);

            const start = saved[win.id] ?? parking(win, i);
            place(win, start.x, start.y);
            repark(win);

            bar.tabIndex = 0;
            bar.setAttribute("role", "application");
            bar.setAttribute("aria-roledescription", MOVE_HINT);
        };

        const drop = (win: HTMLElement) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (win.style.position !== "fixed") return;

            for (const p of [
                "position",
                "left",
                "top",
                "width",
                "margin",
                "z-index",
            ])
                win.style.removeProperty(p);

            bar?.removeAttribute("tabindex");
            bar?.removeAttribute("role");
            bar?.removeAttribute("aria-roledescription");
        };

        const sync = () => {
            document.documentElement.classList.toggle("floating", floats());

            wins.forEach((win, i) => {
                if (!floats()) return drop(win);
                lift(win, i);
                place(
                    win,
                    parseFloat(win.style.left),
                    parseFloat(win.style.top),
                );
            });
        };

        wins.forEach((win) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (!bar) return;

            bar.addEventListener("pointerdown", (e) => {
                if (win.style.position !== "fixed") return;
                if ((e.target as HTMLElement).closest("button")) return;
                e.preventDefault();
                win.style.zIndex = String(++top);

                const r = win.getBoundingClientRect();
                const dx = e.clientX - r.left;
                const dy = e.clientY - r.top;
                bar.setPointerCapture(e.pointerId);
                bar.dataset.dragging = "1";

                const move = (ev: PointerEvent) =>
                    place(win, ev.clientX - dx, ev.clientY - dy);

                const up = (ev: PointerEvent) => {
                    delete bar.dataset.dragging;
                    bar.releasePointerCapture(ev.pointerId);
                    bar.removeEventListener("pointermove", move);
                    bar.removeEventListener("pointerup", up);
                    savePosition(win.id, {
                        x: parseFloat(win.style.left),
                        y: parseFloat(win.style.top),
                    });
                };

                bar.addEventListener("pointermove", move);
                bar.addEventListener("pointerup", up);
            });

            bar.addEventListener("keydown", (e) => {
                if (win.style.position !== "fixed") return;
                const step = e.shiftKey ? 4 : 16;
                const by: Record<string, [number, number]> = {
                    ArrowLeft: [-step, 0],
                    ArrowRight: [step, 0],
                    ArrowUp: [0, -step],
                    ArrowDown: [0, step],
                };
                const d = by[e.key];
                if (!d) return;
                e.preventDefault();
                win.style.zIndex = String(++top);
                savePosition(
                    win.id,
                    place(
                        win,
                        parseFloat(win.style.left) + d[0],
                        parseFloat(win.style.top) + d[1],
                    ),
                );
            });
        });

        sync();

        window.addEventListener("resize", sync);
    }

    function theme() {
        const root = document.documentElement;
        const meta = document.querySelector<HTMLMetaElement>(
            'meta[name="theme-color"]',
        );
        const buttons =
            document.querySelectorAll<HTMLButtonElement>("[data-theme-set]");

        const sync = () => {
            const light = root.classList.contains("light");
            buttons.forEach((b) =>
                b.setAttribute(
                    "aria-pressed",
                    String((b.dataset.themeSet === "light") === light),
                ),
            );

            const bg = getComputedStyle(root).getPropertyValue("--bg").trim();
            if (bg) meta?.setAttribute("content", bg);
        };

        buttons.forEach((b) =>
            b.addEventListener("click", () => {
                const light = b.dataset.themeSet === "light";
                root.classList.toggle("light", light);
                try {
                    localStorage.setItem("theme", light ? "light" : "dark");
                } catch {
                    /*  */
                }
                sync();
            }),
        );

        sync();
    }

    function init() {
        codeBlocks();
        windows();
        theme();
    }

    document.addEventListener("astro:page-load", init);
</script>
