---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import { SITE } from "@consts";
import { HTML_LANG } from "@i18n/ui";
import type { Locale } from "@i18n/utils";

type Props = {
    locale: Locale;
    title: string;
    description: string;
};

const { locale, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0a0507" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

<!-- The ch-based layout is measured against Iosevka, so it is worth the
     early fetch: 19KB each, and everything reflows if they land late. -->
<link
    rel="preload"
    href="/fonts/iosevka-400.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link
    rel="preload"
    href="/fonts/departure-mono.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>

<ViewTransitions />

<!-- Runs before first paint: no theme flash, and no flash of hidden
     content either. Deliberately tiny; everything else waits for the
     module below.

     Dark is the default rather than a mirror of prefers-color-scheme,
     because dark *is* the design here — light is an alternative, and it
     stays one click away and persists once chosen. -->
<script is:inline>
    (() => {
        const root = document.documentElement;
        /* Scripting has proven itself, so controls that need it (the theme
           switch) may exist. Lands before first paint: no dead control
           without JS, no shift with it. */
        root.classList.add("js");
        root.classList.toggle(
            "light",
            localStorage.getItem("theme") === "light",
        );
    })();
</script>

<script>
    /* Code blocks get a strip naming their language and holding the copy
       button. The button lives on the wrapper, never inside <pre>: putting
       it in the code block made its label part of the copied text. */
    function codeBlocks() {
        document
            .querySelectorAll<HTMLPreElement>(".article pre")
            .forEach((pre) => {
                if (pre.parentElement?.classList.contains("code-wrap")) return;

                const wrap = document.createElement("div");
                wrap.className = "code-wrap";
                pre.replaceWith(wrap);

                const bar = document.createElement("div");
                bar.className = "code-bar";

                const lang = document.createElement("span");
                lang.textContent =
                    pre.dataset.language && pre.dataset.language !== "plaintext"
                        ? pre.dataset.language
                        : "text";
                bar.append(lang);

                const button = document.createElement("button");
                button.type = "button";
                button.className = "code-copy";
                button.textContent = "copy";
                button.setAttribute("aria-label", "Copy code to clipboard");
                button.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(pre.innerText);
                        button.textContent = "copied";
                    } catch {
                        button.textContent = "failed";
                    }
                    setTimeout(() => (button.textContent = "copy"), 1600);
                });
                bar.append(button);

                wrap.append(bar, pre);
            });
    }

    /* Windows: closable, reopenable from the taskbar, and draggable by
       their title bar.

       All of it is an enhancement. Without scripting a window is simply
       always open and sits in the document flow, which is the right
       fallback for a panel of static text — so the markup ships in flow
       and this lifts it out, rather than the other way round.

       The first version lifted a window to fixed positioning lazily, on
       first drag. That left it measured from wherever it happened to sit
       in the flow, so a restored position never matched and a drag could
       finish past the bottom of the viewport. Lifting up front, once, at
       a known place removes both. */
    const POS_KEY = "win:pos";
    /* A window may only detach where it actually fits beside the column.
       That is arithmetic, not taste. The column is 984px and centred, so
       each gutter is (100vw - 984) / 2, and a window needs WIN_W + GAP of
       it — hence 984 + 2 * (340 + 24) = 1712. Below that they stay in the
       document flow, which is also the no-script behaviour.

       GAP has to be the same number the default placement uses, below.
       It was 900 for a while (where the old CSS media query sat, before
       the floating moved into script) and a window landed on the prose:
       at 1100px it sat at x=736 with the column running to 1042. Then it
       was derived correctly but with GAP=16 while the placement inset by
       24, and 1700px still overlapped — by exactly the 6px the two
       constants disagreed about. One constant, used twice. */
    const COLUMN = 984;
    const WIN_W = 340;
    const GAP = 24;
    const FLOAT_FROM = COLUMN + 2 * (WIN_W + GAP);

    /* The one string this script says out loud. Read off <html lang>
       rather than imported from the dictionary: importing it would pull
       both locales and all ~260 keys into the client bundle to use one
       of them, which is more JavaScript than the whole site ships. */
    const MOVE_HINT = document.documentElement.lang.startsWith("pt")
        ? "janela, setas movem"
        : "window, arrow keys move";

    type Pos = { x: number; y: number };

    function readPositions(): Record<string, Pos> {
        try {
            return JSON.parse(localStorage.getItem(POS_KEY) ?? "{}");
        } catch {
            return {};
        }
    }

    function savePosition(id: string, pos: Pos) {
        const all = readPositions();
        all[id] = pos;
        localStorage.setItem(POS_KEY, JSON.stringify(all));
    }

    function windows() {
        const wins = [...document.querySelectorAll<HTMLElement>(".window")];
        if (!wins.length) return;

        const setOpen = (id: string, open: boolean) => {
            const win = document.getElementById(id);
            const task = document.querySelector<HTMLButtonElement>(
                `[data-window-task="${id}"]`,
            );
            if (win) win.hidden = !open;
            task?.setAttribute("aria-pressed", String(open));
        };

        document
            .querySelectorAll<HTMLButtonElement>("[data-window-close]")
            .forEach((b) =>
                b.addEventListener("click", () =>
                    setOpen(b.dataset.windowClose!, false),
                ),
            );

        document
            .querySelectorAll<HTMLButtonElement>("[data-window-task]")
            .forEach((b) =>
                b.addEventListener("click", () => {
                    const id = b.dataset.windowTask!;
                    setOpen(id, b.getAttribute("aria-pressed") !== "true");
                }),
            );

        /* Too narrow to float anything without covering the text. */
        if (window.innerWidth < FLOAT_FROM) return;

        const saved = readPositions();
        let top = 50;

        const clamp = (win: HTMLElement, x: number, y: number): Pos => {
            const maxX = Math.max(0, window.innerWidth - win.offsetWidth);
            const maxY = Math.max(0, window.innerHeight - win.offsetHeight);
            return {
                x: Math.min(Math.max(0, x), maxX),
                y: Math.min(Math.max(0, y), maxY),
            };
        };

        const place = (win: HTMLElement, x: number, y: number) => {
            const p = clamp(win, x, y);
            win.style.left = `${p.x}px`;
            win.style.top = `${p.y}px`;
            return p;
        };

        wins.forEach((win, i) => {
            const bar = win.querySelector<HTMLElement>(".window__bar");
            if (!bar) return;

            const width = Math.min(340, window.innerWidth - 32);
            win.style.position = "fixed";
            win.style.margin = "0";
            win.style.width = `${width}px`;
            win.style.zIndex = String(++top);

            const fallback = {
                x: window.innerWidth - width - GAP,
                y: 96 + i * 240,
            };
            const start = saved[win.id] ?? fallback;
            place(win, start.x, start.y);

            bar.addEventListener("pointerdown", (e) => {
                if ((e.target as HTMLElement).closest("button")) return;
                e.preventDefault();
                win.style.zIndex = String(++top);

                const r = win.getBoundingClientRect();
                const dx = e.clientX - r.left;
                const dy = e.clientY - r.top;
                bar.setPointerCapture(e.pointerId);
                bar.dataset.dragging = "1";

                const move = (ev: PointerEvent) =>
                    place(win, ev.clientX - dx, ev.clientY - dy);

                const up = (ev: PointerEvent) => {
                    delete bar.dataset.dragging;
                    bar.releasePointerCapture(ev.pointerId);
                    bar.removeEventListener("pointermove", move);
                    bar.removeEventListener("pointerup", up);
                    savePosition(win.id, {
                        x: parseFloat(win.style.left),
                        y: parseFloat(win.style.top),
                    });
                };

                bar.addEventListener("pointermove", move);
                bar.addEventListener("pointerup", up);
            });

            /* Dragging is functionality, so it has to work without a
               pointer too. The bar is only made focusable here, in the
               branch that actually floats the window — in the flow it
               moves nothing, and a tab stop that does nothing is worse
               than no tab stop. */
            bar.tabIndex = 0;
            bar.setAttribute("role", "application");
            bar.setAttribute("aria-roledescription", MOVE_HINT);

            bar.addEventListener("keydown", (e) => {
                const step = e.shiftKey ? 4 : 16;
                const by: Record<string, [number, number]> = {
                    ArrowLeft: [-step, 0],
                    ArrowRight: [step, 0],
                    ArrowUp: [0, -step],
                    ArrowDown: [0, step],
                };
                const d = by[e.key];
                if (!d) return;
                e.preventDefault();
                win.style.zIndex = String(++top);
                savePosition(
                    win.id,
                    place(
                        win,
                        parseFloat(win.style.left) + d[0],
                        parseFloat(win.style.top) + d[1],
                    ),
                );
            });
        });

        /* A resize can strand a window past the new edge. */
        window.addEventListener("resize", () => {
            wins.forEach((win) => {
                if (win.style.position !== "fixed") return;
                place(win, parseFloat(win.style.left), parseFloat(win.style.top));
            });
        });
    }

    /* The theme switch: two labelled states beside the language switcher,
       current one in reverse video. The visual state comes straight from
       the `light` class on <html>, so this only keeps the pressed
       semantics and the browser chrome colour in step, and persists the
       choice under the key the pre-paint script reads. */
    function theme() {
        const root = document.documentElement;
        const meta = document.querySelector<HTMLMetaElement>(
            'meta[name="theme-color"]',
        );
        const buttons =
            document.querySelectorAll<HTMLButtonElement>("[data-theme-set]");

        const sync = () => {
            const light = root.classList.contains("light");
            buttons.forEach((b) =>
                b.setAttribute(
                    "aria-pressed",
                    String((b.dataset.themeSet === "light") === light),
                ),
            );
            /* Read the live token so a palette change can never strand a
               stale hex here. */
            const bg = getComputedStyle(root).getPropertyValue("--bg").trim();
            if (bg) meta?.setAttribute("content", bg);
        };

        buttons.forEach((b) =>
            b.addEventListener("click", () => {
                const light = b.dataset.themeSet === "light";
                root.classList.toggle("light", light);
                localStorage.setItem("theme", light ? "light" : "dark");
                sync();
            }),
        );

        sync();
    }

    function init() {
        codeBlocks();
        windows();
        theme();
    }

    document.addEventListener("astro:page-load", init);
</script>
