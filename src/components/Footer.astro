---
import { SITE, SOCIALS } from "@consts";
import { compact, getStats } from "@lib/stats";

const stats = await getStats();
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="shell">
        <div class="cols">
            <div>
                <div class="label">contact</div>
                <ul class="links">
                    <li>
                        <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
                    </li>
                    {
                        SOCIALS.map(({ NAME, HANDLE, HREF }) => (
                            <li>
                                <span class="dim">{NAME} </span>
                                <a
                                    href={HREF}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {HANDLE}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <div class="label">build</div>
                <pre class="ascii meta"><span class="dim">posts  </span>{
                    String(stats.posts).padStart(6)
                }
<span class="dim">words  </span>{compact(stats.words).padStart(6)}
<span class="dim">commit </span>{stats.commit.padStart(6)}
<span class="dim">built  </span>{stats.built}</pre>
            </div>
        </div>

        <div class="colophon">
            <span>© {year} {SITE.TITLE}</span>
            <span class="dim">
                Astro · Iosevka &amp; Departure Mono (OFL 1.1)
            </span>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: calc(var(--step) * 3);
        padding-block: var(--step);
        border-top: 1px solid var(--line);
        font-size: 0.93em;
    }

    .cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(34ch, 1fr));
        gap: var(--step) 4ch;
    }

    .label {
        margin-bottom: 0.4rem;
        font-family: var(--font-display);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
    }

    .links {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .links li + li {
        margin-top: 0.15rem;
    }

    .dim {
        color: var(--dim);
    }

    .meta {
        font-size: inherit;
        line-height: 1.5;
        color: var(--base);
    }

    .colophon {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 2ch;
        margin-top: var(--step);
        padding-top: 0.75rem;
        border-top: 1px solid var(--line);
        color: var(--dim);
    }
</style>
