---
/**
 * An aside inside an article. Framed and labelled rather than led by an
 * emoji, so it holds up in the monochrome design — and the label is real
 * text, which the emoji version was not.
 */
type Props = {
    type?: "note" | "info" | "warning" | "error";
    label?: string;
};

const { type = "note", label } = Astro.props;

const DEFAULT_LABEL: Record<string, string> = {
    note: "note",
    info: "info",
    warning: "warning",
    error: "danger",
};
---

<aside class:list={["callout", type]}>
    <p class="callout-label">{label ?? DEFAULT_LABEL[type]}</p>
    <div class="callout-body">
        <slot />
    </div>
</aside>

<style>
    .callout {
        position: relative;
        margin-block: var(--step);
        padding: calc(var(--step) * 0.6) 2ch;
        border: 1px solid var(--line);
        border-left-width: 2px;
        background: var(--bg-raised);
    }

    .callout-label {
        margin: 0 0 0.3rem;
        font-family: var(--font-display);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--dim);
    }

    .callout-label::before {
        content: "─ ";
    }

    .callout-body :global(> :first-child) {
        margin-top: 0;
    }

    .callout-body :global(> :last-child) {
        margin-bottom: 0;
    }

    .note {
        border-left-color: var(--dim);
    }

    .info {
        border-left-color: var(--base);
    }

    .warning {
        border-left-color: #d99a3c;
    }

    .warning .callout-label {
        color: #d99a3c;
    }

    .error {
        border-left-color: var(--accent);
    }

    .error .callout-label {
        color: var(--accent);
    }
</style>
