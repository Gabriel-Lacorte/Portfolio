---
/**
 * An aside inside an article. Framed and labelled rather than led by an
 * emoji, so it holds up in the monochrome design, and the label is real
 * text, which the emoji version was not.
 */
type Props = {
    type?: "note" | "info" | "warning" | "error";
    label?: string;
};

const { type = "note", label } = Astro.props;

const DEFAULT_LABEL: Record<string, string> = {
    note: "note",
    info: "info",
    warning: "warning",
    error: "danger",
};
---

<aside class:list={["callout", type]}>
    <p class="callout-label">{label ?? DEFAULT_LABEL[type]}</p>
    <div class="callout-body">
        <slot />
    </div>
</aside>

<style>
    .callout {
        margin: 15px 0;
        padding-left: 12px;
        border-left: var(--hair);
    }

    .callout-label {
        margin: 0;
        color: var(--comment);
    }

    .callout-label::before {
        content: "! ";
    }

    .warning .callout-label {
        color: var(--amber);
    }

    .error .callout-label {
        color: var(--red);
    }

    .callout-body :global(> :first-child) {
        margin-top: 0;
    }

    .callout-body :global(> :last-child) {
        margin-bottom: 0;
    }
</style>
