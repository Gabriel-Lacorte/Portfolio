---
/**
 * A bordered panel with a title strip — the unit every page is built out
 * of. Nothing on this site floats free of a frame.
 *
 * The border is a real CSS border rather than a run of ┌─┐│└┘: character
 * borders cannot reflow, so they break the moment the panel is narrower
 * than the content inside it.
 */
type Props = {
    title: string;
    /** Right-aligned in the title strip: a count, a date, a status. */
    note?: string;
    /** Heading level for the title, so document outline stays correct. */
    as?: "h1" | "h2" | "h3";
    class?: string;
    bodyClass?: string;
};

const {
    title,
    note,
    as: Tag = "h2",
    class: className,
    bodyClass,
} = Astro.props;
---

<section class:list={["panel", className]}>
    <Tag class="panel-head">
        <span>{title}</span>
        {note && <span class="note">{note}</span>}
    </Tag>
    <div class:list={["panel-body", bodyClass]}>
        <slot />
    </div>
</section>
