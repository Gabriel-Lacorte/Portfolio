---
/**
 * A five-cell level bar, the way the avionics panels in the references
 * annotate a channel: [••−−]→ MON-A.
 *
 * The bar restates the label beside it rather than replacing it, so it is
 * decorative — a screen reader gets the word FLUENT, not five block
 * characters.
 */
type Props = {
    /** 0–5 filled cells. */
    level: number;
    class?: string;
};

const { level, class: className } = Astro.props;

const FULL = "█";
const HALF = "▒";
const EMPTY = "░";
const CELLS = 5;

const clamped = Math.max(0, Math.min(CELLS, Math.round(level)));

/* One transitional cell so the bar reads as a gradient rather than a
   hard on/off, which is what the reference panels do. */
const bar = Array.from({ length: CELLS }, (_, i) => {
    if (i < clamped - 1) return FULL;
    if (i === clamped - 1) return clamped === CELLS ? FULL : HALF;
    return EMPTY;
}).join("");
---

<span class:list={["meter", className]} aria-hidden="true">[{bar}]</span>

<style>
    .meter {
        flex: none;
        color: var(--dim);
        letter-spacing: 0;
        user-select: none;
    }
</style>
