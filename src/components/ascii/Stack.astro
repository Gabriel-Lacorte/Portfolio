---
import { STACK } from "@consts";

/**
 * The privilege stack — the home page's centrepiece.
 *
 * Each ring gets a denser fill as it descends, so the picture reads as
 * weight without any colour beyond the ramp. The marked ring is the layer
 * this site is about.
 *
 * The fill bars are decorative; every row's meaning is carried by its text
 * columns, which a screen reader gets in order.
 */
const BAR = 16;
---

<div class="stack">
    {
        STACK.map(({ RING, NAME, FILL, DETAIL, HERE }) => (
            <div class:list={["row", HERE && "here"]}>
                <span class="ring">{RING}</span>
                <span class="name">{NAME}</span>
                <span class="bar" aria-hidden="true">
                    {FILL.repeat(BAR)}
                </span>
                <span class="detail">{DETAIL}</span>
                {HERE && <span class="mark">◄ here</span>}
            </div>
        ))
    }
</div>

<style>
    .stack {
        display: grid;
        gap: 0.15rem;
        font-size: 0.93em;
        overflow-x: auto;
    }

    .row {
        display: grid;
        grid-template-columns: 8ch 12ch 17ch 1fr auto;
        align-items: baseline;
        gap: 1ch;
        min-width: 62ch;
        color: var(--dim);
    }

    .ring {
        color: var(--faint);
        font-variant-numeric: tabular-nums;
    }

    .name {
        color: var(--base);
    }

    .bar {
        color: var(--ramp-4);
        letter-spacing: 0;
        user-select: none;
    }

    .detail {
        color: var(--dim);
    }

    .here .name,
    .here .detail {
        color: var(--bright);
    }

    .here .bar {
        color: var(--accent);
    }

    .mark {
        color: var(--accent);
        white-space: nowrap;
    }

    @media (max-width: 640px) {
        .stack {
            /* Keep the cell grid intact and let it scroll rather than
               collapsing the columns into a ragged stack. */
            padding-bottom: 0.5rem;
        }
    }
</style>
