---
/**
 * A decorative dither strip, the way a release flyer breaks a column.
 * Purely texture — hidden from assistive tech, and it clips rather than
 * wraps so it always reads as one continuous band.
 */
type Props = {
    /** "fade" ramps dark→light→dark; "check" is a hard checkerboard. */
    pattern?: "fade" | "check";
    class?: string;
};

const { pattern = "fade", class: className } = Astro.props;

const CELL =
    pattern === "check"
        ? "▚▚▚▚▚▚▚▚"
        : "░░▒▒▓▓██▓▓▒▒░░  ";

/* Long enough to overflow any realistic panel; the strip clips. */
const BAND = CELL.repeat(40);
---

<div class:list={["dither", className]} aria-hidden="true">{BAND}</div>
