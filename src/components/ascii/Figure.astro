---
/**
 * An ASCII diagram.
 *
 * Deliberately not a diagram DSL — you write the art directly as the
 * slot's content and this handles the framing, caption, cell lock, mobile
 * scrolling, and text alternative. A sequence-diagram mini-language would
 * be more machinery than drawing the thing.
 *
 * `alt` is required: without it a screen reader gets several hundred box
 * characters read one at a time, which is worse than no figure at all.
 */
type Props = {
    /** Prose description announced in place of the art. */
    alt: string;
    caption?: string;
    label?: string;
    /** Drop the frame — for figures already sitting inside a panel. */
    bare?: boolean;
};

const { alt, caption, label, bare = false } = Astro.props;
---

<figure class:list={["fig", bare && "bare"]}>
    <div class="fig-art" role="img" aria-label={alt}>
        <pre class="ascii"><slot /></pre>
    </div>
    {
        (label || caption) && (
            <figcaption>
                {label && <span class="fig-label">{label}</span>}
                {caption}
            </figcaption>
        )
    }
</figure>

<style>
    .fig {
        margin: var(--step) 0;
    }

    .fig.bare {
        margin: 0;
    }

    .fig-art {
        padding: 0.8rem var(--pad);
        border: 1px solid var(--rule);
        overflow-x: auto;
        overscroll-behavior-x: contain;
    }

    .fig.bare .fig-art {
        padding: 0;
        border: 0;
    }

    .fig-art pre {
        margin: 0;
        color: var(--ink);
        /* Even sizes only. Iosevka advances 0.5em per cell, so an odd
           font-size puts every character on a half pixel and the box
           rules render with a gap between glyphs — a solid ─── run comes
           out dashed. 14px gives a 7px advance; 10px gives 5px.
           Line-height is tight enough that vertical rules join, loose
           enough that label text stays readable. */
        font-size: 14px;
        line-height: 1.2;
    }

    figcaption {
        margin-top: 0.6rem;
        color: var(--dim);
        font-size: 0.88em;
    }

    @media (max-width: 900px) {
        .fig-art pre {
            font-size: 10px;
        }
    }

    .fig-label {
        margin-right: 1ch;
        color: var(--bright);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
</style>
