---
/**
 * An ASCII diagram.
 *
 * Deliberately not a diagram DSL — you write the art directly as the
 * slot's content and this handles the framing, caption, cell lock, mobile
 * scrolling, and text alternative. A sequence-diagram mini-language would
 * be more machinery than drawing the thing.
 *
 * `alt` is required: without it a screen reader gets several hundred box
 * characters read one at a time, which is worse than no figure at all.
 */
type Props = {
    /** Prose description announced in place of the art. */
    alt: string;
    caption?: string;
    label?: string;
    /** Drop the frame — for figures already sitting inside a panel. */
    bare?: boolean;
};

const { alt, caption, label, bare = false } = Astro.props;
---

<figure class:list={["fig", bare && "bare"]}>
    <div class="fig-art" role="img" aria-label={alt}>
        <pre class="ascii"><slot /></pre>
    </div>
    {
        (label || caption) && (
            <figcaption>
                {label && <span class="fig-label">{label}</span>}
                {caption}
            </figcaption>
        )
    }
</figure>

<style>
    .fig {
        margin: 15px 0;
    }

    .fig-art {
        padding: 10px 12px;
        border: var(--hair);
        overflow-x: auto;
        overscroll-behavior-x: contain;
    }

    .fig.bare .fig-art {
        padding: 0;
        border: 0;
    }

    .fig-art pre {
        margin: 0;
        font-family: var(--code);
        color: var(--base);
        /* Even size only: Iosevka advances 0.5em per cell, so an odd
           font-size lands every glyph on a half pixel and a solid ───
           run renders dashed. 14px gives a 7px advance. */
        font-size: 14px;
        line-height: 1.2;
    }

    figcaption {
        margin-top: 6px;
        color: var(--comment);
        font-size: 14px;
    }

    .fig-label {
        margin-right: 8px;
        /* --purple never existed; the .purple class always meant the
           accent. Cite the real token. */
        color: var(--accent);
    }

    @media (max-width: 700px) {
        .fig-art pre {
            font-size: 10px;
        }
    }
</style>
