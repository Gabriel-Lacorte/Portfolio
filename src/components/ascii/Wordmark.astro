<style>
    /* 96 cells at Iosevka's 0.5em advance is 48em, so 100/48 ≈ 2.08cqw
       fills the container it is dropped into. Sized in container units so
       nothing beside it can crop the last letter. */
    .wordmark {
        width: 100%;
        font-size: min(2.02cqw, 15px);
        line-height: 1.02;
        color: var(--ink);
        overflow: visible;
        user-select: none;
    }
</style>
