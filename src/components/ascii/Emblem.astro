<style>
    /* Sized in ch and flex: none. Left to size itself the <pre> claims its
       full 44-character intrinsic width as a flex item and starves the
       wordmark beside it of every pixel. */
    .emblem {
        flex: none;
        width: 44ch;
        font-size: 5.2px;
        line-height: 0.92;
        color: var(--ink);
        overflow: visible;
        user-select: none;
    }
</style>
