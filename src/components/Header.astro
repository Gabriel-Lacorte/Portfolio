---
import { NAV, SITE } from "@consts";

/* Trailing slashes normalised so "/blog/kerberos" marks ~/blog as current
   and "/" only ever marks itself. */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isCurrent = (href: string) =>
    href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="site-header">
    <div class="shell bar">
        <a class="brand" href="/">{SITE.HANDLE}</a>

        <nav aria-label="Main">
            <ul>
                {
                    NAV.map(({ LABEL, HREF }) => (
                        <li>
                            <a
                                href={HREF}
                                class:list={[
                                    "nav-link",
                                    isCurrent(HREF) && "current",
                                ]}
                                aria-current={
                                    isCurrent(HREF) ? "page" : undefined
                                }
                            >
                                {LABEL}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <button id="theme-toggle" type="button" class="theme-toggle no-print">
            <span class="sr-only">Switch theme, currently</span>
            <span aria-hidden="true" data-theme-label>·</span>
        </button>
    </div>
</header>

<style>
    .site-header {
        border-bottom: 1px solid var(--line);
        background: var(--bg);
    }

    .bar {
        display: flex;
        align-items: center;
        gap: 2ch;
        flex-wrap: wrap;
        padding-block: 0.6rem;
    }

    .brand {
        font-family: var(--font-display);
        letter-spacing: 0.08em;
        text-decoration: none;
        color: var(--bright);
    }

    .brand:hover {
        background: var(--accent);
        color: var(--bg);
    }

    nav {
        flex: 1;
    }

    nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 2ch;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-link {
        text-decoration: none;
        color: var(--dim);
    }

    .nav-link:hover {
        color: var(--bg);
        background: var(--accent);
    }

    /* Current page is inverted — the idiom the old neocities nav used, and
       it still reads with colour stripped out. */
    .nav-link.current {
        color: var(--bg);
        background: var(--base);
    }

    .nav-link.current:hover {
        background: var(--accent);
    }

    .theme-toggle {
        padding: 0 1ch;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--dim);
        font: inherit;
        cursor: pointer;
    }

    .theme-toggle:hover {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--bg);
    }

    @media (max-width: 640px) {
        .bar {
            gap: 1ch 2ch;
        }

        nav {
            flex-basis: 100%;
            order: 3;
        }
    }
</style>
