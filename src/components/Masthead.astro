---
type Props = {
    tagline: string;
};

const { tagline } = Astro.props;

const GLYPHS: Record<string, string[]> = {
    l: ["██ ", "██ ", "██ ", "▀▀▀"],
    a: [" ▄▄▄▄ ", " ▄▄▄██", "██  ██", " ▀▀▀▀▀"],
    c: [" ▄▄▄▄", "██   ", "██   ", " ▀▀▀▀"],
    o: [" ▄▄▄▄ ", "██  ██", "██  ██", " ▀▀▀▀ "],
    r: ["▄▄▄▄▄", "██ ▀▀", "██   ", "▀▀   "],
    t: [" ▄▄ ", "▀██▀", " ██ ", " ▀▀▀"],
    e: [" ▄▄▄▄ ", "██▄▄██", "██    ", " ▀▀▀▀ "],
    ".": ["  ", "  ", "▄▄", "▀▀"],
};

const rows: (string | { dot: string })[][] = [[], [], [], []];
[..."lacort.ee"].forEach((ch, i) => {
    const glyph = GLYPHS[ch];
    const w = Math.max(...glyph.map((row) => row.length));
    if (i > 0) for (let r = 0; r < 4; r++) rows[r].push(" ");
    for (let r = 0; r < 4; r++) {
        const cell = glyph[r].padEnd(w);
        rows[r].push(ch === "." ? { dot: cell } : cell);
    }
});

const ART = rows
    .map((segs) =>
        segs
            .map((seg) => (typeof seg === "string" ? seg : `<span class="dot">${seg.dot}</span>`))
            .join(""),
    )
    .join("\n");
---

<div class="masthead">
    <div class="art" role="img" aria-label="lacort.ee">
        <pre set:html={ART} />
    </div>
    <p class="who">{tagline}</p>
</div>

<style>
    .masthead {
        margin: 0 0 10px;
    }

    .art pre {
        margin: 0;
        font-family: var(--code);
        font-size: 14px;
        line-height: 1;
        white-space: pre;
        color: var(--base);
    }

    .art :global(.dot) {
        color: var(--accent);
        text-shadow: var(--glow);
    }

    .who {
        margin: 8px 0 0;
        color: var(--comment);
    }

    @media (max-width: 560px) {
        .art pre {
            font-size: 2.55vw;
        }
    }
</style>
