---
const {
    run,
    arg,
    aside,
    icon = "term",
    as: Tag = "h2",
    id,
} = Astro.props;

---

<Tag class="cmd" id={id}>
    <span
        class="icon"
        style={`--glyph: url(/icons/${icon}.png)`}
        aria-hidden="true"></span>
    <span class="run">{run}</span>
    {arg && <span class="flag">{arg}</span>}
    {/* Real, unrepeated facts (post counts, dates, reading time), so they are
        read out with the heading rather than hidden from it. */}
    {aside && <span class="aside">{aside}</span>}
</Tag>
